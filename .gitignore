# test fixtures" step on every CI run (compiled from
# mdix_files/tests/dlm/11..13_enum_only_*.mdix), never checked in.
mdix-csharp/tests/MidManStudio.Mdix.Core.Tests/fixtures/
mdix-python/tests/fixtures/

# ---------------------------------------------------------------------------
# Intended NuGet packaging pipeline (not yet an actual CI workflow — see
# mdix-core-cs-publish.yml, which currently only tests, doesn't pack/push):
#
#   cargo build -p mdix-ffi
#       -> writes MdixNative.cs into Core/Generated/ (self-contained)
#   dotnet build Core
#       -> compiles MdixNative.cs + all Core/*.cs into Core.dll
#   dotnet pack Core  (after CI fills runtimes/)
#       -> MidManStudio.Mdix.1.0.0.nupkg containing:
#            lib/netstandard2.1/MidManStudio.Mdix.Core.dll
#            runtimes/win-x64/native/mdix_ffi.dll
#            runtimes/linux-x64/native/libmdix_ffi.so
#            runtimes/osx-arm64/native/libmdix_ffi.dylib
#            build/MidManStudio.Mdix.targets
#
#   Unity package (separate, already exists — see build-upm.yml):
#       -> drops pre-built Core.dll into Runtime/Core/Plugins/
#       -> copies native libs into Runtime/Plugins/{Platform}/
# ---------------------------------------------------------------------------
