// Brought to u by MidManStudio
//
// Removes the stale copies of docs/ and others/schema_section_spec.md that
// ended up INSIDE the Unity package (com.midmanstudio.mdix/Editor/docs and
// com.midmanstudio.mdix/Editor/others). They arrived via the two earlier
// replacements deliveries (commits eef92017 and 308e8f84), which were applied
// with target_root = com.midmanstudio.mdix/Editor instead of the repo root.
// Unity then reports every one of them as "has no meta file, but it's in an
// immutable folder" because package folders installed from git are read-only.
//
// Nothing is lost by deleting them:
//   - Editor/docs/** is OLDER than the real docs/ at the repo root (it still
//     documents bzip2-support / xz-support, which root docs/dixscript/features.md
//     has since replaced).
//   - Editor/others/schema_section_spec.md is byte-identical to
//     others/schema_section_spec.md at the repo root.
//   - No C# file in the package reads either folder.
//
// delete_files:: removes FILES only, never directories, so every file in both
// folders is listed. The emptied folders vanish from git on commit because git
// does not track empty directories.
//
// Run "Apply Surgical Patch" with dry_run = true first.
@CONFIG(
  version    -> "1.0.0"
  features   -> "quickfuncs,data"
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~delete_file<object>(_path) {
    return { path = _path }
  }
)

@DATA(
  delete_files::
    delete_file("com.midmanstudio.mdix/Editor/docs/dixscript.md")
    delete_file("com.midmanstudio.mdix/Editor/docs/dixscript/compiler.md")
    delete_file("com.midmanstudio.mdix/Editor/docs/dixscript/features.md")
    delete_file("com.midmanstudio.mdix/Editor/docs/dixscript/utilities.md")
    delete_file("com.midmanstudio.mdix/Editor/others/schema_section_spec.md")
)
