// Cleans up after the first codec-removal drop.
//
// 1. ROOT_README.md is a stray file. The first drop packed the repo-root README as
//    ROOT_README.md and relied on a manifest override to land it as README.md, but the
//    manifest in .mdix/replacements/ was the older one with no override, so the file
//    was created under its own name. It is deleted here.
// 2. The one-line README.md change the stray file was meant to carry is applied
//    in place instead.
//
// Put this at .mdix/patches/patch.mdix and run "Apply Surgical Patch" (dry_run = true
// first). Run it after the replacements drop. It deletes one file and edits one line.
@CONFIG(
  version    -> "1.0.0"
  features   -> "quickfuncs,data"
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~delete_file<object>(path) { return { path = path } }
  ~patch_replace_text<object>(path, anchor, content) {
    return { path = path, op = "replace_text", anchor = anchor, content = content }
  }
)

@DATA(
  delete_files::
    delete_file("ROOT_README.md")

  patch_files::
    patch_replace_text("README.md", "(gzip/bzip2/lzma)", "(gzip)")
)
