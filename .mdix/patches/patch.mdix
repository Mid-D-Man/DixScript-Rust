// Deletes the two codec source files that the codec-removal drop stops compiling.
//
// Put this at .mdix/patches/patch.mdix and run "Apply Surgical Patch" (dry_run = true
// first; it lists what it would delete). This replaces the template that is there now,
// the Unity-mirror cleanup. That folder (com.midmanstudio.mdix/Editor/dixscript) no
// longer exists in the repo, so that cleanup has already been applied.
//
// Run it AFTER the replacements drop. Once Compressor/mod.rs no longer declares these
// modules, the files are dead code, so deleting them is safe. Only files are listed;
// the delete pass removes files, not directories, and the Compressor folder keeps
// gzip_compressor.rs, compressor_trait.rs and mod.rs.
//
// mdix_files/tests/dlm/02_bzip2.mdix and 03_lzma.mdix are NOT deleted here on purpose.
// The edge-case runner uses the mdix binary built from the published dixscript 1.0.0,
// which still has both codecs, so those two fixtures still pass today. Retire them
// when mdix-cli moves to the release that carries this change.
@CONFIG(
  version    -> "1.0.0"
  features   -> "quickfuncs,data"
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~delete_file<object>(path) { return { path = path } }
)

@DATA(
  delete_files::
    delete_file("dixscript/src/Compiler/DLM/Compressor/bzip2_compressor.rs")
    delete_file("dixscript/src/Compiler/DLM/Compressor/lzma_compressor.rs")
)
