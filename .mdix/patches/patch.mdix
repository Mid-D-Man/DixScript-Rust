// Updates the Rust version badge in the repo-root README.md from 1.85+ to 1.75+.
//
// Why this is a patch and not part of the replacements archive: the root README.md
// would be a flat archive member, and "README.md" matches many files in this repo,
// so it needs a manifest override. A one-line edit does not justify that.
//
// Put this at .mdix/patches/patch.mdix and run "Apply Surgical Patch" (dry_run = true
// first). It touches one line and deletes nothing. The other README (dixscript/README.md)
// is already updated by the replacements archive.
@CONFIG(
  version    -> "1.0.0"
  features   -> "quickfuncs,data"
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~patch_replace_text<object>(path, anchor, content) {
    return { path = path, op = "replace_text", anchor = anchor, content = content }
  }
)

@DATA(
  patch_files::
    patch_replace_text("README.md", "rust-1.85+", "rust-1.75+")
)
