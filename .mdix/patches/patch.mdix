// =============================================================================
// RUSTC-HASH WIRING PATCH  ·  DixScript v1.0.0
// =============================================================================
// Swaps `use rustc_hash::...` for the hand-rolled port at
// `crate::Utilities::RustcHash` in the 13 files that import it. One identical
// kind of edit across many files, so it is a patch rather than 13 re-shipped
// files. Each anchor is a whole `use` line that occurs exactly once in its file.
//
// ORDER MATTERS: apply the replacements archive FIRST (it adds the RustcHash
// module and makes it public), then run this patch. Several of these files are
// also inside that archive, so do not leave the archive in .mdix/replacements/
// afterwards: a later replacements run would re-extract the older copies over
// the patched files. Set `delete_processed_archives` when applying it.
// =============================================================================

@CONFIG(
  version    -> "1.0.0"
  author     -> "MidManStudio"
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~patch_replace_text<object>(_path, _anchor, _content) {
    return {
      path    = _path
      op      = "replace_text"
      anchor  = _anchor
      content = _content
    }
  }
)

@DATA(
  description = "Wire in the hand-rolled rustc-hash port: 13 import lines"

  patch_files::

    patch_replace_text(
      "dixscript/src/Compiler/Core/SectionAnalyzers/data_section_analyzer.rs",
      "use rustc_hash::{FxHashMap, FxHashSet};",
      "use crate::Utilities::RustcHash::{FxHashMap, FxHashSet};"
    )

    patch_replace_text(
      "dixscript/src/Compiler/Core/SectionAnalyzers/dlm_section_analyzer.rs",
      "use rustc_hash::FxHashSet;",
      "use crate::Utilities::RustcHash::FxHashSet;"
    )

    patch_replace_text(
      "dixscript/src/Compiler/Core/SectionAnalyzers/enums_section_analyzer.rs",
      "use rustc_hash::{FxHashSet, FxHashMap};",
      "use crate::Utilities::RustcHash::{FxHashSet, FxHashMap};"
    )

    patch_replace_text(
      "dixscript/src/Compiler/Core/SectionAnalyzers/imports_section_analyzer.rs",
      "use rustc_hash::FxHashSet;",
      "use crate::Utilities::RustcHash::FxHashSet;"
    )

    patch_replace_text(
      "dixscript/src/Compiler/Core/SectionAnalyzers/quickfuncs_section_analyzer.rs",
      "use rustc_hash::{FxHashMap, FxHashSet};",
      "use crate::Utilities::RustcHash::{FxHashMap, FxHashSet};"
    )

    patch_replace_text(
      "dixscript/src/Compiler/Core/SectionAnalyzers/raw_section_analyzer.rs",
      "use rustc_hash::FxHashMap;",
      "use crate::Utilities::RustcHash::FxHashMap;"
    )

    patch_replace_text(
      "dixscript/src/Compiler/Core/SectionAnalyzers/security_section_analyzer.rs",
      "use rustc_hash::FxHashMap;",
      "use crate::Utilities::RustcHash::FxHashMap;"
    )

    patch_replace_text(
      "dixscript/src/Compiler/Core/SectionEnhancers/qualified_identifier_resolver.rs",
      "use rustc_hash::FxHashMap;",
      "use crate::Utilities::RustcHash::FxHashMap;"
    )

    patch_replace_text(
      "dixscript/src/Compiler/Core/ValueResolution/ast_walker.rs",
      "use rustc_hash::FxHashMap;",
      "use crate::Utilities::RustcHash::FxHashMap;"
    )

    patch_replace_text(
      "dixscript/src/Compiler/Core/ValueResolution/execution_context.rs",
      "use rustc_hash::FxHashMap;",
      "use crate::Utilities::RustcHash::FxHashMap;"
    )

    patch_replace_text(
      "dixscript/src/Compiler/Core/ValueResolution/function_interpreter.rs",
      "use rustc_hash::FxHashMap;",
      "use crate::Utilities::RustcHash::FxHashMap;"
    )

    patch_replace_text(
      "dixscript/src/Compiler/Core/ValueResolution/supporting_classes.rs",
      "use rustc_hash::FxHashMap;",
      "use crate::Utilities::RustcHash::FxHashMap;"
    )

    patch_replace_text(
      "dixscript/src/Compiler/Core/ValueResolution/value_resolver.rs",
      "use rustc_hash::FxHashMap;",
      "use crate::Utilities::RustcHash::FxHashMap;"
    )
)
