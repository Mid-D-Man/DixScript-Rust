// OPTIONAL, separate on purpose because it deletes.
//
// Deletes the 114 files of com.midmanstudio.mdix/Editor/dixscript/, a stray copy
// of the Rust source that two earlier "Apply replacements" runs created inside the
// Unity package (they ran with the Unity template manifest, so target_root was
// com.midmanstudio.mdix/Editor). The folder first appears in the bot commits of
// 2026-10-05 and 2026-10-07 and in no other commit, nothing in the repo references
// it, and build-upm.yml does not use it. Only files are listed (the delete pass
// removes files, not directories); the emptied folders disappear from git on their
// own.
//
// This is a normal scaffold template, NOT a replacements manifest. Put it at
//     .mdix/cleanup-unity-mirror.mdix
// and run the "Apply replacements" workflow with
//     template = .mdix/cleanup-unity-mirror.mdix
// (try dry_run = true first; it lists what it would delete).
@CONFIG(
  version    -> "1.0.0"
  features   -> "quickfuncs,data"
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~delete_file<object>(path) { return { path = path } }
)

@DATA(
  delete_files::
    delete_file("com.midmanstudio.mdix/Editor/dixscript/Cargo.toml")
    delete_file("com.midmanstudio.mdix/Editor/dixscript/benches/runtime_benchmark.rs")
