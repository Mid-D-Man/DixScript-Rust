@CONFIG(
  version    -> "1.0.0"
  features   -> "quickfuncs,data"
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~target<object>(name, path) { return { name = name, path = path } }
)

@DATA(
  target_root = "com.midmanstudio.mdix/Editor"

  overrides::
    target("README.md",    "com.midmanstudio.mdix/README.md")
    target("CHANGELOG.md", "com.midmanstudio.mdix/CHANGELOG.md")
)
