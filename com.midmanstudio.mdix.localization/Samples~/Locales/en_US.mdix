// com.midmanstudio.mdix.localization/Samples~/en_US.mdix

@CONFIG(
  version -> "2.0.0"
  author  -> "MidMan Studio"
)

@IMPORTS(
  loc from "localization_helpers.mdix"
)

@DATA(
  // ── Locale identity (flat SimpleProperty, must precede all grouped entries) ──

  locale_display_name<string> = "English (US)"
  locale_bcp47<string>        = "en-US"
  locale_plural_rule<enum>    = loc.PluralRule.ONE_OTHER
  locale_script_dir<enum>     = loc.ScriptDir.LTR
  locale_gender_sys<enum>     = loc.GenderSystem.NONE

  // ── Plural keys — p2 produces .one and .other sub-keys ──────────────────────

  plural_enemies = loc.p2("1 enemy",  "{0} enemies")
  plural_coins   = loc.p2("1 coin",   "{0} coins")
  plural_items   = loc.p2("1 item",   "{0} items")
  plural_lives   = loc.p2("1 life",   "{0} lives")

  // ── Annotated keys — key() bakes note, max_chars, valid, warning ─────────────

  hud_score   = loc.key("Score: {0}",  "HUD score counter — {0} is the score value",      20)
  hud_health  = loc.key("HP: {0}",     "HUD health bar label — {0} is current HP",        12)
  hud_level   = loc.key("Level {0}",   "HUD level indicator — {0} is the level number",   12)
  ui_new_game = loc.key("New Game",    "Main menu — start a new game",                     16)
  ui_resume   = loc.key("Resume",      "Pause menu — resume the current game",             12)
  ui_quit     = loc.key("Quit",        "Quit the game entirely",                           10)

  // ── Grouped string tables (each TablePath defined exactly once) ───────────────

  fmt:      decimal_sep = ".",  thousands_sep = ",",  date_pattern = "MM/DD/YYYY"
  ui:       play = "Play",  settings = "Settings",  back = "Back",  confirm = "Confirm",  cancel = "Cancel"
  menu:     start = "Start Game",  options = "Options",  credits = "Credits",  exit = "Exit"
  gameplay: paused = "Paused",  game_over = "Game Over",  victory = "Victory!",  loading = "Loading…"
  errors:   load_failed = "Failed to load",  network = "Network error",  save_failed = "Save failed"
  prompts:  are_you_sure = "Are you sure?",  yes = "Yes",  no = "No"
)
