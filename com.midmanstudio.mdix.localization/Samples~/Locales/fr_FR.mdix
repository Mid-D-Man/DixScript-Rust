// com.midmanstudio.mdix.localization/Samples~/fr_FR.mdix

@CONFIG(
  version -> "2.0.0"
  author  -> "MidMan Studio"
)

@IMPORTS(
  loc from "localization_helpers.mdix"
)

@DATA(
  // ── Locale identity ──────────────────────────────────────────────────────────

  locale_display_name<string> = "Français (France)"
  locale_bcp47<string>        = "fr-FR"
  locale_plural_rule<enum>    = loc.PluralRule.ONE_OTHER
  locale_script_dir<enum>     = loc.ScriptDir.LTR
  locale_gender_sys<enum>     = loc.GenderSystem.MASC_FEM

  // ── Plural keys ───────────────────────────────────────────────────────────────

  plural_enemies = loc.p2("1 ennemi",  "{0} ennemis")
  plural_coins   = loc.p2("1 pièce",   "{0} pièces")
  plural_items   = loc.p2("1 objet",   "{0} objets")
  plural_lives   = loc.p2("1 vie",     "{0} vies")

  // ── Annotated keys ────────────────────────────────────────────────────────────

  hud_score   = loc.key("Score : {0}",    "HUD compteur de score — {0} est la valeur",       20)
  hud_health  = loc.key("PV : {0}",       "HUD points de vie — {0} est la valeur actuelle",  12)
  hud_level   = loc.key("Niveau {0}",     "HUD indicateur de niveau — {0} est le numéro",    14)
  ui_new_game = loc.key("Nouvelle partie", "Menu principal — démarrer une nouvelle partie",  20)
  ui_resume   = loc.key("Reprendre",       "Menu pause — reprendre la partie en cours",       16)
  ui_quit     = loc.key("Quitter",         "Quitter le jeu entièrement",                      12)

  // ── Grouped string tables ─────────────────────────────────────────────────────

  fmt:      decimal_sep = ",",  thousands_sep = " ",  date_pattern = "DD/MM/YYYY"
  ui:       play = "Jouer",  settings = "Paramètres",  back = "Retour",  confirm = "Confirmer",  cancel = "Annuler"
  menu:     start = "Nouvelle partie",  options = "Options",  credits = "Crédits",  exit = "Quitter"
  gameplay: paused = "En pause",  game_over = "Fin de partie",  victory = "Victoire !",  loading = "Chargement…"
  errors:   load_failed = "Échec du chargement",  network = "Erreur réseau",  save_failed = "Échec de la sauvegarde"
  prompts:  are_you_sure = "Êtes-vous sûr ?",  yes = "Oui",  no = "Non"
)
