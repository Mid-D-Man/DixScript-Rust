// com.midmanstudio.mdix.localization/Samples~/Locales/fr_FR.mdix
@CONFIG(
  version  -> "1.0.0"
  locale   -> "fr_FR"
  fallback -> "en_US"
)

@DATA(
  locale_display_name<string> = "Français (France)"

  ui: play = "Jouer", settings = "Paramètres", quit = "Quitter", back = "Retour"
  ui: resume = "Reprendre", loading = "Chargement...", ok = "OK", cancel = "Annuler"

  menu: new_game = "Nouvelle Partie", load_game = "Charger", credits = "Crédits"

  gameplay: score = "Score : {0}", level = "Niveau {0}", lives = "Vies : {0}"
  gameplay: wave = "Vague {0}", time = "Temps : {0}"

  notify: level_up = "Niveau Supérieur !"
  notify: game_over = "Partie Terminée"
  notify: new_record = "Nouveau Record : {0} !"

  items: sword = "Épée en Fer", potion = "Potion de Soin", shield = "Bouclier en Bois"
  items: gold = "Pièce d'Or", gem = "Gemme de Rubis"

  tutorial: hint_move = "Utilisez ZQSD ou les flèches pour vous déplacer"
  tutorial: hint_attack = "Appuyez sur Espace pour attaquer"
  tutorial: hint_dodge = "Double appui pour esquiver"

  enemies: goblin = "Gobelin", orc = "Orque", dragon = "Dragon"

  // French plural: 0 and 1 use singular form in some cases
  plural_enemies::  "Aucun ennemi", "1 ennemi", "{0} ennemis"
  plural_coins::    "Aucune pièce", "1 pièce",  "{0} pièces"
  plural_items::    "Aucun objet",  "1 objet",  "{0} objets"

  errors: save_failed = "Échec de la sauvegarde : {0}"
  errors: load_failed = "Impossible de charger la sauvegarde"
  errors: network_err = "Erreur réseau. Vérifiez votre connexion."
)
