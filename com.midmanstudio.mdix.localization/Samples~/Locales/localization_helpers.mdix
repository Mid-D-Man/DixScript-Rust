// com.midmanstudio.mdix.localization/Samples~/localization_helpers.mdix

@CONFIG(
  version  -> "1.0.0"
  author   -> "MidMan Studio"
  features -> "advanced"
)

@ENUMS(
  // 27 families, mechanically extracted from real CLDR v48 data and
  // verified against an independent re-evaluation across 67,710
  // (locale, count) pairs with zero mismatches -- see
  // CldrPluralFamilies.cs for the exact language list behind each and the
  // full extraction method. ONE_OTHER, ZERO_ONE_OTHER, SLAVIC, ARABIC, and
  // NONE are the 5 names this enum shipped with originally; each is kept
  // verbatim because it's an exact behavioral match for its real CLDR
  // family (SLAVIC specifically means Russian/Belarusian/Ukrainian only --
  // Polish and Czech/Slovak each have their own distinct rule and their
  // own family below, POLISH and CZECH_SLOVAK, not SLAVIC).
  PluralRule {
    ONE_OTHER, NONE, ZERO_ONE_MERGED_OTHER, ONE_TWO_OTHER, ROMANCE_MILLIONS,
    ZERO_ONE_OTHER, SERBO_CROATIAN, SLAVIC, FILIPINO, SORBIAN_SLOVENIAN,
    ARABIC, CZECH_SLOVAK, FRENCH_PORTUGUESE, ICELANDIC_MACEDONIAN,
    BALTIC_LATVIAN, ROMANIAN, BRETON, WELSH, IRISH, SCOTTISH_GAELIC, MANX,
    CORNISH, LITHUANIAN, MALTESE, POLISH, TASHELHIT, CENTRAL_ATLAS_TAMAZIGHT
  }
  ScriptDir    { LTR, RTL }
  GenderSystem { NONE, MASC_FEM, FULL }
)

@QUICKFUNCS(

  // Two-form plural — ONE_OTHER-shaped locales (English, German, Spanish …)
  // Produces: key.one, key.other
  ~p2<object>(one<string>, other<string>) {
    return {
      one   = one
      other = other
    }
  }

  // Four-form plural — for any locale whose PluralRule resolves to a
  // one/few/many category set (SLAVIC's Russian/Belarusian/Ukrainian,
  // POLISH, or CZECH_SLOVAK -- three distinct real rules, not one), with
  // an optional hand-authored zero override via the .zero key (pre-empts
  // the resolver at count == 0 regardless of what that locale's real CLDR
  // rule maps 0 to).
  // Produces: key.zero, key.one, key.few, key.many
  ~p4<object>(zero<string>, one<string>, few<string>, many<string>) {
    return {
      zero = zero
      one  = one
      few  = few
      many = many
    }
  }

  // Annotated string — bakes note, char-limit, and over-limit flag at parse time.
  // Produces: key.value, key.note, key.max_chars, key.valid, key.warning
  ~key<object>(value<string>, note<string>, max_chars<int>) {
    let over = value.length() > max_chars
    return {
      value     = value
      note      = note
      max_chars = max_chars
      valid     = !over
      warning   = over ? $"OVER: {value.length()} > {max_chars} chars" : ""
    }
  }

  // Gender pair — masculine / feminine forms for fully inflected locales.
  // Produces: key.masc, key.fem
  ~g<object>(masc<string>, fem<string>) {
    return {
      masc = masc
      fem  = fem
    }
  }

  // UI display / screen-reader accessibility pair.
  // Produces: key.display, key.a11y
  ~ui<object>(display<string>, a11y<string>) {
    return {
      display = display
      a11y    = a11y
    }
  }

)
