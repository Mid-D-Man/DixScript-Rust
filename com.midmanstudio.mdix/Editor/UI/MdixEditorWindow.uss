/* ── Root ──────────────────────────────────────────────────────────────── */
.mdix-root {
    background-color: #080C14;
    flex-direction: column;
    flex-grow: 1;
}

/* ── Title bar ─────────────────────────────────────────────────────────── */
.mdix-titlebar {
    background-color: #0D1220;
    flex-direction: row;
    align-items: center;
    padding: 0 12px;
    height: 36px;
    border-bottom-width: 1px;
    border-bottom-color: #1A2540;
}

.mdix-titlebar__title {
    color: #E8EDF5;
    font-size: 13px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.mdix-titlebar__file {
    color: #7A98C4;
    font-size: 11px;
}

/* ── Tab bar ────────────────────────────────────────────────────────────── */
.mdix-tabbar {
    background-color: #0D1220;
    flex-direction: row;
    align-items: flex-end;
    padding: 0 12px;
    height: 34px;
    border-bottom-width: 1px;
    border-bottom-color: #1A2540;
}

.mdix-tab {
    color: #7A98C4;
    font-size: 12px;
    padding: 6px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    cursor: link;
}

.mdix-tab:hover {
    color: #B8C8E0;
    background-color: #141E30;
}

.mdix-tab--active {
    color: #E8EDF5;
    background-color: #080C14;
    border-top-width: 2px;
    border-top-color: #3B7EF6;
    -unity-font-style: bold;
}

/* ── Tab indicator dots ─────────────────────────────────────────────────── */
.mdix-tab__dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    margin-right: 6px;
    background-color: #3B7EF6;
}

.mdix-tab__dot--warning {
    background-color: #F0A030;
}

/* ── Toolbar ────────────────────────────────────────────────────────────── */
.mdix-toolbar {
    background-color: #0D1220;
    flex-direction: row;
    align-items: center;
    padding: 4px 12px;
    height: 32px;
    border-bottom-width: 1px;
    border-bottom-color: #1A2540;
}

.mdix-toolbar__spacer {
    flex-grow: 1;
}

.mdix-btn {
    background-color: #141E30;
    color: #B8C8E0;
    border-color: #1A2540;
    border-width: 1px;
    border-radius: 3px;
    padding: 3px 10px;
    font-size: 11px;
    cursor: link;
    margin-left: 4px;
}

.mdix-btn:hover {
    background-color: #1A2A44;
    color: #E8EDF5;
    border-color: #3B7EF6;
}

.mdix-btn--primary {
    background-color: #1E3A7A;
    color: #E8EDF5;
    border-color: #3B7EF6;
}

.mdix-btn--primary:hover {
    background-color: #2448A0;
}

.mdix-btn--success {
    background-color: #0F3020;
    color: #6FD68F;
    border-color: #2A7A48;
}

/* ── Status badge ───────────────────────────────────────────────────────── */
.mdix-status {
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
    margin-right: 8px;
    font-size: 11px;
    color: #6FD68F;
}

.mdix-status--error {
    color: #F4836A;
}

/* ── Content panels ─────────────────────────────────────────────────────── */
.mdix-panel {
    flex-grow: 1;
    background-color: #080C14;
}

/* ── Explorer tab ───────────────────────────────────────────────────────── */
.mdix-explorer {
    flex-direction: column;
    flex-grow: 1;
    padding: 0;
}

.mdix-section-header {
    background-color: #0D1220;
    color: #7A98C4;
    font-size: 10px;
    -unity-font-style: bold;
    padding: 4px 12px;
    letter-spacing: 1px;
    border-bottom-width: 1px;
    border-bottom-color: #1A2540;
}

/* Flat key-value rows */
.mdix-kv-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 12px;
    border-bottom-width: 1px;
    border-bottom-color: #0F1828;
    min-height: 28px;
}

.mdix-kv-row:hover {
    background-color: #0F1828;
}

.mdix-kv__key {
    color: #7A98C4;
    font-size: 11px;
    width: 180px;
    flex-shrink: 0;
}

.mdix-kv__value {
    color: #E8EDF5;
    font-size: 11px;
    flex-grow: 1;
}

.mdix-kv__type {
    color: #3B7EF6;
    font-size: 10px;
    background-color: #0D1E38;
    border-radius: 3px;
    padding: 1px 5px;
    margin-left: 8px;
}

.mdix-kv__type--enum {
    color: #E879A0;
    background-color: #2A0D1E;
}

.mdix-kv__type--bool {
    color: #F0A030;
    background-color: #2A1800;
}

.mdix-kv__type--string {
    color: #6FD68F;
    background-color: #0D2018;
}

/* Array table */
.mdix-table {
    margin: 8px 12px;
    border-width: 1px;
    border-color: #1A2540;
    border-radius: 4px;
}

.mdix-table__header-row {
    background-color: #0D1220;
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: #1A2540;
}

.mdix-table__header-cell {
    color: #7A98C4;
    font-size: 10px;
    -unity-font-style: bold;
    padding: 6px 10px;
    flex-grow: 1;
    letter-spacing: 0.5px;
}

.mdix-table__row {
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: #0F1828;
    min-height: 28px;
    align-items: center;
}

.mdix-table__row:hover {
    background-color: #0F1828;
}

.mdix-table__row--boss {
    background-color: #1A1000;
}

.mdix-table__row--boss:hover {
    background-color: #231500;
}

.mdix-table__cell {
    color: #E8EDF5;
    font-size: 11px;
    padding: 4px 10px;
    flex-grow: 1;
}

.mdix-table__cell--enum-boss {
    color: #F0A030;
}

/* ── Editor tab ─────────────────────────────────────────────────────────── */
.mdix-code-area {
    flex-grow: 1;
    background-color: #080C14;
    color: #E8EDF5;
    font-size: 13px;
    -unity-font-style: normal;
    padding: 12px;
    border-width: 0;
    white-space: pre;
}

/* ── Templates tab ──────────────────────────────────────────────────────── */
.mdix-template-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 16px;
}

.mdix-template-card {
    background-color: #0D1220;
    border-color: #1A2540;
    border-width: 1px;
    border-radius: 6px;
    width: 180px;
    margin: 6px;
    padding: 14px;
    cursor: link;
}

.mdix-template-card:hover {
    border-color: #3B7EF6;
    background-color: #0F1828;
}

.mdix-template-card__title {
    color: #E8EDF5;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.mdix-template-card__desc {
    color: #7A98C4;
    font-size: 10px;
    white-space: normal;
}

/* ── Status bar ─────────────────────────────────────────────────────────── */
.mdix-statusbar {
    background-color: #0D1220;
    flex-direction: row;
    align-items: center;
    padding: 0 12px;
    height: 22px;
    border-top-width: 1px;
    border-top-color: #1A2540;
}

.mdix-statusbar__item {
    color: #7A98C4;
    font-size: 10px;
    margin-right: 16px;
}

.mdix-statusbar__item--ok {
    color: #6FD68F;
}

.mdix-statusbar__item--error {
    color: #F4836A;
}

/* ── Value popups (dates, timestamps, long text) ───────────────────────── */
.mdix-pop__scrim {
    background-color: rgba(4, 8, 16, 0.65);
}

.mdix-pop {
    background-color: #0D1220;
    border-width: 1px;
    border-color: #3B7EF6;
    border-radius: 6px;
    padding: 12px 14px;
    min-width: 320px;
    max-width: 96%;
    max-height: 96%;
}

.mdix-pop__title {
    color: #E8EDF5;
    font-size: 13px;
    -unity-font-style: bold;
}

.mdix-pop__subtitle {
    color: #7A98C4;
    font-size: 11px;
    margin-bottom: 8px;
}

.mdix-pop__hint {
    color: #7A98C4;
    font-size: 11px;
    margin-top: 6px;
    white-space: normal;
}

.mdix-pop__error {
    color: #F4836A;
    font-size: 11px;
    margin-top: 8px;
    white-space: normal;
}

.mdix-pop__footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.mdix-pop__row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.mdix-pop__caption {
    color: #7A98C4;
    font-size: 11px;
    width: 40px;
}

.mdix-pop__sep {
    color: #7A98C4;
    margin: 0 2px;
}

.mdix-pop__input--bad .unity-base-text-field__input {
    border-color: #F4836A;
}

.mdix-pop__seg {
    margin-left: 0;
    margin-right: 2px;
}

.mdix-pop__seg--on {
    background-color: #1E3A7A;
    color: #E8EDF5;
    border-color: #3B7EF6;
}

/* Month grid */
.mdix-cal__nav {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 4px;
}

.mdix-cal__navbtn {
    width: 28px;
    margin: 0 2px;
    padding: 3px 0;
    -unity-text-align: middle-center;
}

.mdix-cal__month {
    flex-grow: 1;
    color: #E8EDF5;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.mdix-cal__row {
    flex-direction: row;
}

.mdix-cal__dow {
    width: 34px;
    margin: 1px;
    color: #7A98C4;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.mdix-cal__day {
    width: 34px;
    height: 26px;
    margin: 1px;
    color: #E8EDF5;
    font-size: 12px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
    cursor: link;
}

.mdix-cal__day:hover {
    background-color: #1A2A44;
}

.mdix-cal__day--out {
    color: #4A5A78;
}

.mdix-cal__day--today {
    border-color: #3B7EF6;
}

.mdix-cal__day--selected {
    background-color: #1E3A7A;
    color: #FFFFFF;
}

.mdix-cal__day--none {
    color: rgba(0, 0, 0, 0);
    cursor: arrow;
}

.mdix-cal__day--none:hover {
    background-color: rgba(0, 0, 0, 0);
}

.mdix-cal__now {
    align-self: flex-start;
    margin-top: 8px;
    margin-left: 0;
}

/* Regex popup */
.mdix-rx {
    width: 480px;
}

.mdix-rx__caption {
    color: #7A98C4;
    font-size: 11px;
    margin-top: 6px;
    margin-bottom: 2px;
}

.mdix-rx__test {
    height: 70px;
}

.mdix-rx__status {
    color: #6FD68F;
    font-size: 11px;
    margin-top: 6px;
    min-height: 14px;
    white-space: normal;
}

.mdix-rx__note {
    color: #E0B25C;
    font-size: 11px;
    margin-top: 4px;
    white-space: normal;
}

.mdix-rx__list {
    max-height: 160px;
    margin-top: 6px;
    padding: 4px 6px;
    background-color: #0A0F1A;
    border-width: 1px;
    border-color: #1E2B45;
    border-radius: 3px;
}

.mdix-rx__hit {
    color: #E8EDF5;
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 2px;
    white-space: normal;
}

.mdix-rx__group {
    color: #7A98C4;
    font-size: 11px;
    margin-left: 14px;
    white-space: normal;
}

/* Blob popup */
.mdix-blob {
    width: 440px;
}

.mdix-blob__info {
    color: #E8EDF5;
    font-size: 12px;
    -unity-font-style: bold;
    margin-top: 4px;
}

.mdix-blob__preview {
    margin-top: 8px;
    padding: 8px;
    min-height: 56px;
    align-items: center;
    background-color: #0A0F1A;
    border-width: 1px;
    border-color: #1E2B45;
    border-radius: 3px;
}

.mdix-blob__audio {
    align-self: stretch;
    align-items: flex-start;
}

.mdix-blob__dump {
    align-self: stretch;
    max-height: 170px;
    margin-top: 6px;
}

.mdix-blob__mono {
    color: #C7D3E8;
    font-size: 11px;
    white-space: nowrap;
}

.mdix-blob__buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}
