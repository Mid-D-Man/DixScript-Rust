<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MidManStudio.Mdix</RootNamespace>

    <!-- NuGet metadata -->
    <PackageId>MidManStudio.Mdix</PackageId>
    <Version>1.0.0</Version>
    <Authors>MidManStudio</Authors>
    <Description>DixScript (.mdix) runtime — load, read, and build .mdix config files.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Mid-D-Man/DixScript-Rust</RepositoryUrl>
    <PackageTags>config;data;encryption;dixscript;mdix</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- MdixNative.cs is auto-generated by the Rust build step.
       We link it here so Rider resolves it for IntelliSense.
       Unity picks it up via its own asmdef — no duplication. -->
  <ItemGroup>
    <Compile Include="..\..\..\unity-package\Runtime\Generated\MdixNative.cs"
             Link="Generated\MdixNative.cs" />
  </ItemGroup>

</Project>
