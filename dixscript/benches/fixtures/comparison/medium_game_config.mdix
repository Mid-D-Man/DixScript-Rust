@CONFIG(
  version  -> "1.0.0"
  author   -> "Benchmark Fixture — Medium Game Config"
  features -> "advanced"
)

@ENUMS(
  Rarity      { COMMON = 0, UNCOMMON = 1, RARE = 2, EPIC = 3, LEGENDARY = 4 }
  WeaponClass { SWORD = 1, AXE = 2, BOW = 3, STAFF = 4, DAGGER = 5 }
  ArmorSlot   { HEAD = 1, CHEST = 2, LEGS = 3, HANDS = 4, FEET = 5 }
  EnemyType   { HUMANOID = 1, BEAST = 2, UNDEAD = 3, ELEMENTAL = 4, BOSS = 5 }
  DropChance  { ALWAYS = 100, COMMON_DROP = 60, UNCOMMON_DROP = 30, RARE_DROP = 10, LEGENDARY_DROP = 2 }
)

@QUICKFUNCS(
  ~rarityMultiplier<int>(r<enum>) {
    return r == Rarity.COMMON    ? 1  :
           r == Rarity.UNCOMMON  ? 2  :
           r == Rarity.RARE      ? 4  :
           r == Rarity.EPIC      ? 8  : 16
  }

  ~weapon<object>(id<string>, name<string>, wclass<enum>, base_dmg<int>, rarity<enum>, weight<float>) {
    let mult<int>       = rarityMultiplier(rarity)
    let damage<int>     = base_dmg * mult
    let sell_value<int> = damage * 3
    let dps<float>      = damage / weight
    return {
      id         = id
      name       = name
      class      = wclass
      rarity     = rarity
      damage     = damage
      weight     = weight
      dps        = dps
      sell_value = sell_value
      two_handed = wclass == WeaponClass.SWORD || wclass == WeaponClass.AXE
    }
  }

  ~armor<object>(id<string>, name<string>, slot<enum>, base_def<int>, rarity<enum>, weight<float>) {
    let mult<int>       = rarityMultiplier(rarity)
    let defense<int>    = base_def * mult
    let sell_value<int> = defense * 2
    return {
      id         = id
      name       = name
      slot       = slot
      rarity     = rarity
      defense    = defense
      weight     = weight
      sell_value = sell_value
    }
  }

  ~enemy<object>(id<string>, name<string>, etype<enum>, base_hp<int>, xp<int>, rarity<enum>, drop_rate<enum>) {
    let mult<int>      = rarityMultiplier(rarity)
    let health<int>    = base_hp * mult
    let xp_reward<int> = xp * mult
    let gold<int>      = xp_reward / 2
    return {
      id         = id
      name       = name
      type       = etype
      rarity     = rarity
      health     = health
      xp_reward  = xp_reward
      gold_drop  = gold
      drop_rate  = drop_rate
      is_boss    = etype == EnemyType.BOSS
    }
  }

  ~loot<object>(id<string>, item_id<string>, chance<enum>) {
    return {
      loot_id  = id
      item_id  = item_id
      chance   = chance
    }
  }

  ~level<object>(num<int>, name<string>, xp_required<int>, unlock_count<int>) {
    let bonus_hp<int>   = num * 10
    let bonus_atk<int>  = num * 2
    let bonus_def<int>  = num * 1
    return {
      level        = num
      name         = name
      xp_required  = xp_required
      bonus_hp     = bonus_hp
      bonus_attack = bonus_atk
      bonus_defense= bonus_def
      unlocks      = unlock_count
    }
  }
)

