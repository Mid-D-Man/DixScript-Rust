//! tests/fixtures/function_calls_heavy.mdix
//! Heavy function calls test for value resolution benchmarking

@CONFIG(
    version -> "1.0.0",
    encoding -> "utf-8",
    author -> "DixScript Test Suite",
    features -> "advanced",
    debug_mode -> "off",
    error_handling -> "continue"
)

@ENUMS(
    Status { ACTIVE = 1, INACTIVE = 2, PENDING = 3 },
    Priority { LOW = 1, MEDIUM = 2, HIGH = 3, CRITICAL = 4 }
)

@QUICKFUNCS(
    ~double<int> => global(x<int>) {
        return x * 2;
    }

    ~triple<int> => global(x<int>) {
        return x * 3;
    }

    ~add<int> => global(x<int>, y<int>) {
        return x + y;
    }

    ~multiply<int> => global(x<int>, y<int>) {
        return x * y;
    }

    ~increment<int> => global(x<int>) {
        return x + 1;
    }

    ~decrement<int> => global(x<int>) {
        return x - 1;
    }

    ~square<int> => global(x<int>) {
        return x * x;
    }

    ~isEven<bool> => global(x<int>) {
        return x % 2 == 0;
    }

    ~max<int> => global(a<int>, b<int>) {
        if: a > b {
            return a;
        }
        return b;
    }

    ~min<int> => global(a<int>, b<int>) {
        if: a < b {
            return a;
        }
        return b;
    }
)

@DATA(
    // 50+ function calls for resolution testing
    call_01 = double(5),
    call_02 = triple(7),
    call_03 = add(10, 20),
    call_04 = multiply(3, 4),
    call_05 = increment(99),

    call_06 = decrement(100),
    call_07 = square(8),
    call_08 = double(call_01),
    call_09 = add(call_01, call_02),
    call_10 = multiply(call_03, 2),

    call_11 = double(11),
    call_12 = triple(12),
    call_13 = add(call_11, call_12),
    call_14 = square(5),
    call_15 = increment(call_14),

    call_16 = double(16),
    call_17 = triple(17),
    call_18 = add(18, 19),
    call_19 = multiply(19, 2),
    call_20 = increment(20),

    call_21 = decrement(21),
    call_22 = square(22),
    call_23 = double(23),
    call_24 = triple(24),
    call_25 = add(25, 26),

    call_26 = multiply(26, 2),
    call_27 = increment(27),
    call_28 = decrement(28),
    call_29 = square(29),
    call_30 = double(30),

    call_31 = triple(31),
    call_32 = add(32, 33),
    call_33 = multiply(33, 2),
    call_34 = increment(34),
    call_35 = decrement(35),

    call_36 = square(6),
    call_37 = double(37),
    call_38 = triple(38),
    call_39 = add(39, 40),
    call_40 = multiply(40, 2),

    call_41 = increment(41),
    call_42 = decrement(42),
    call_43 = square(43),
    call_44 = double(44),
    call_45 = triple(45),

    call_46 = add(46, 47),
    call_47 = multiply(47, 2),
    call_48 = increment(48),
    call_49 = decrement(49),
    call_50 = square(50),

    // Nested calls
    nested_01 = add(double(5), triple(3)),
    nested_02 = multiply(add(2, 3), square(4)),
    nested_03 = double(add(10, 20)),
    nested_04 = triple(multiply(5, 6)),
    nested_05 = add(square(7), double(8)),

    // Chained calls
    chain_01 = increment(increment(increment(100))),
    chain_02 = double(double(double(2))),
    chain_03 = add(add(1, 2), add(3, 4)),

    // Boolean checks
    check_01 = isEven(call_01),
    check_02 = isEven(call_02),
    check_03 = isEven(call_03),

    // Min/Max operations
    max_01 = max(call_01, call_02),
    max_02 = max(call_03, call_04),
    min_01 = min(call_05, call_06)
)