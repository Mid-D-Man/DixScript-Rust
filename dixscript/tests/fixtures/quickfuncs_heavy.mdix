// tests/fixtures/quickfuncs_heavy.mdix
// Heavy QuickFunctions test for AST enhancement benchmarking

@CONFIG(
    version -> "1.0.0",
    encoding -> "utf-8",
    author -> "DixScript Test Suite",
    features -> "advanced",
    debug_mode -> "off",
    error_handling -> "continue"
)

@ENUMS(
    Status { ACTIVE = 1, INACTIVE = 2, PENDING = 3, ARCHIVED = 4 },
    Priority { LOW = 1, MEDIUM = 2, HIGH = 3, CRITICAL = 4 },
    Category { A = 10, B = 20, C = 30, D = 40 }
)

@QUICKFUNCS(
    // Math operations
    ~add<int> => global(x<int>, y<int>) {
        return x + y;
    }

    ~subtract<int> => global(x<int>, y<int>) {
        return x - y;
    }

    ~multiply<int> => global(x<int>, y<int>) {
        return x * y;
    }

    ~divide<double> => global(x<double>, y<double>) {
        if: y == 0.0 {
            return 0.0;
        }
        return x / y;
    }

    ~power<double> => global(base<double>, exp<double>) {
        return base ** exp;
    }

    // String operations
    ~concat<string> => global(a<string>, b<string>) {
        return a + b;
    }

    ~format<string> => global(template<string>, value<int>) {
        return $"{template}: {value}";
    }

    // Boolean logic
    ~and<bool> => global(a<bool>, b<bool>) {
        return a && b;
    }

    ~or<bool> => global(a<bool>, b<bool>) {
        return a || b;
    }

    ~not<bool> => global(value<bool>) {
        return !value;
    }

    // Enum operations
    ~isActive<bool> => global(status<enum>) {
        return status == Status.ACTIVE;
    }

    ~isPriority<bool> => global(priority<enum>, threshold<enum>) {
        return priority >= threshold;
    }

    // Complex calculations
    ~calculateScore<double> => global(base<int>, multiplier<double>, bonus<int>) {
        let intermediate = base * multiplier;
        let final = intermediate + bonus;
        return final;
    }

    ~validateRange<bool> => global(value<int>, min<int>, max<int>) {
        if: value < min {
            return false;
        }
        if: value > max {
            return false;
        }
        return true;
    }

    ~processData<int> => global(input<int>, operation<int>) {
        let step1 = input * 2;
        let step2 = step1 + operation;
        let step3 = step2 / 2;
        return step3;
    }

    // Array operations
    ~sumArray<int> => global(arr<array>) {
        let total<int> = arr.sum();
        return total;
    }

    ~averageArray<double> => global(arr<array>) {
        let total<int> = arr.sum();
        let count<int> = arr.length();
        if: count == 0 {
            return 0.0;
        }
        return total / count;
    }

    // Conditional logic
    ~maxValue<int> => global(a<int>, b<int>) {
        if: a > b {
            return a;
        }
        return b;
    }

    ~minValue<int> => global(a<int>, b<int>) {
        if: a < b {
            return a;
        }
        return b;
    }

    ~clamp<int> => global(value<int>, min<int>, max<int>) {
        if: value < min {
            return min;
        }
        if: value > max {
            return max;
        }
        return value;
    }

    // Switch/Case operations
    ~getStatusName<string> => global(status<enum>) {
        chk: status {
            -> Status.ACTIVE { return "Active"; }
            -> Status.INACTIVE { return "Inactive"; }
            -> Status.PENDING { return "Pending"; }
            -> Status.ARCHIVED { return "Archived"; }
            -> miss { return "Unknown"; }
        }
    }

    ~getPriorityLevel<int> => global(priority<enum>) {
        chk: priority {
            -> Priority.LOW { return 1; }
            -> Priority.MEDIUM { return 2; }
            -> Priority.HIGH { return 3; }
            -> Priority.CRITICAL { return 4; }
            -> miss { return 0; }
        }
    }
)

@DATA(
    // Test data (minimal - focus is on QuickFuncs)
    test_value = 100,
    test_status<enum> = Status.ACTIVE,
    test_priority<enum> = Priority.HIGH
)