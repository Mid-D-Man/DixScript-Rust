<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MidManStudio.Mdix</RootNamespace>

    <!-- NuGet metadata -->
    <PackageId>MidManStudio.Mdix</PackageId>
    <Version>1.0.0</Version>
    <Authors>MidManStudio</Authors>
    <Description>DixScript (.mdix) runtime — load, read, and build .mdix config files.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Mid-D-Man/DixScript-Rust</RepositoryUrl>
    <!-- FIX: was missing -- nuget.org uses RepositoryUrl+RepositoryType together to
         render the "Source repository" link on the package page. -->
    <RepositoryType>git</RepositoryType>
    <PackageTags>config;data;encryption;dixscript;mdix</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- FIX: was missing -- nuget.org renders this on the package page. The file is
         bundled below via the README <None> item. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      FIX: SourceLink + deterministic build were entirely missing. Together these let a
      consumer's debugger step into the exact commit this package was built from,
      fetched straight from GitHub, without a local source checkout.
      ContinuousIntegrationBuild is gated to CI only (the standard pattern) so local
      `dotnet pack` for manual testing isn't forced into deterministic-path mode, which
      would otherwise embed CI-only absolute paths that don't resolve for a local dev.
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!--
      Suppress warnings when native runtimes/ files are absent.
      NU5100: file outside lib/ — expected for runtimes/ layout.
      NU5128: no lib/ for a given target — we are netstandard2.1 only.
      CI must run `cargo build -p mdix-ffi` per target before `dotnet pack`.
    -->
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>

  <!--
    MdixNative.cs is auto-generated by `cargo build -p mdix-ffi` into
    Generated/ inside this project. The .NET SDK auto-includes all *.cs files,
    so NO explicit <Compile> item is needed here — adding one causes a
    "Duplicate Compile items" build error.
    Generated/ is git-ignored; run the cargo build (or let CI create the stub) first.
  -->

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="6.0.10" />
    <!-- FIX: was missing -- see PublishRepositoryUrl/EmbedUntrackedSources above.
         PrivateAssets="All" keeps this a build-time-only dependency; it is not
         carried transitively to consumers of this package. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- FIX: was missing -- bundles the package README (added alongside this project)
       so it appears on the nuget.org package page per PackageReadmeFile above. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Native library bundling for NuGet consumers (runtimes/ RID convention).

    .NET Core 3.0+ / .NET 5+ copies the correct native lib to the consumer's
    output directory automatically at build time — no .targets file needed for
    those hosts.

    The Condition="Exists(...)" guard on each item means `dotnet pack` succeeds
    even when a particular platform native is absent (e.g. you are on Linux and
    have not cross-compiled for Windows yet). A complete release pack requires
    all platforms to be built first.

    CI folder layout relative to this .csproj — populate before `dotnet pack`:
      runtimes/
        win-x64/native/mdix_ffi.dll
        win-x86/native/mdix_ffi.dll
        linux-x64/native/libmdix_ffi.so
        linux-arm64/native/libmdix_ffi.so
        osx-x64/native/libmdix_ffi.dylib
        osx-arm64/native/libmdix_ffi.dylib
        android-arm64/native/libmdix_ffi.so   (Xamarin / MAUI consumers)
  -->
  <ItemGroup>
    <None Include="runtimes\win-x64\native\mdix_ffi.dll"
          Condition="Exists('runtimes\win-x64\native\mdix_ffi.dll')"
          Pack="true"
          PackagePath="runtimes/win-x64/native/mdix_ffi.dll"
          CopyToOutputDirectory="PreserveNewest" />

    <None Include="runtimes\win-x86\native\mdix_ffi.dll"
          Condition="Exists('runtimes\win-x86\native\mdix_ffi.dll')"
          Pack="true"
          PackagePath="runtimes/win-x86/native/mdix_ffi.dll"
          CopyToOutputDirectory="PreserveNewest" />

    <None Include="runtimes\linux-x64\native\libmdix_ffi.so"
          Condition="Exists('runtimes\linux-x64\native\libmdix_ffi.so')"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/libmdix_ffi.so"
          CopyToOutputDirectory="PreserveNewest" />

    <None Include="runtimes\linux-arm64\native\libmdix_ffi.so"
          Condition="Exists('runtimes\linux-arm64\native\libmdix_ffi.so')"
          Pack="true"
          PackagePath="runtimes/linux-arm64/native/libmdix_ffi.so"
          CopyToOutputDirectory="PreserveNewest" />

    <None Include="runtimes\osx-x64\native\libmdix_ffi.dylib"
          Condition="Exists('runtimes\osx-x64\native\libmdix_ffi.dylib')"
          Pack="true"
          PackagePath="runtimes/osx-x64/native/libmdix_ffi.dylib"
          CopyToOutputDirectory="PreserveNewest" />

    <None Include="runtimes\osx-arm64\native\libmdix_ffi.dylib"
          Condition="Exists('runtimes\osx-arm64\native\libmdix_ffi.dylib')"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native/libmdix_ffi.dylib"
          CopyToOutputDirectory="PreserveNewest" />

    <None Include="runtimes\android-arm64\native\libmdix_ffi.so"
          Condition="Exists('runtimes\android-arm64\native\libmdix_ffi.so')"
          Pack="true"
          PackagePath="runtimes/android-arm64/native/libmdix_ffi.so"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    .targets file bundled in the NuGet package under build/.
    NuGet auto-injects this into every consumer project at restore time.
    It handles copy-to-output for .NET Framework and older hosts that do not
    process the runtimes/ folder automatically.
  -->
  <ItemGroup>
    <None Include="build\MidManStudio.Mdix.targets"
          Pack="true"
          PackagePath="build\MidManStudio.Mdix.targets" />
  </ItemGroup>

</Project>
