{
    "name": "midmanstudio/mdix",
    "description": "DixScript (.mdix) runtime — PHP FFI bindings for MidManStudio",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MidManStudio",
            "homepage": "https://github.com/Mid-D-Man/DixScript-Rust"
        }
    ],
    "keywords": ["dixscript", "mdix", "config", "data", "midmanstudio"],
    "homepage": "https://github.com/Mid-D-Man/DixScript-Rust",
    "require": {
        "php": ">=8.1",
        "ext-ffi": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "MidManStudio\\Mdix\\": "src/Mdix/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MidManStudio\\Mdix\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "extra": {
        "native-lib": {
            "note": "Run 'cargo build -p mdix-ffi --release' then copy the platform lib to mdix-php/lib/ before running tests.",
            "linux":   "lib/libmdix_ffi.so",
            "macos":   "lib/libmdix_ffi.dylib",
            "windows": "lib/mdix_ffi.dll"
        }
    }
}
