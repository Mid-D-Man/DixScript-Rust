# ── MdixMerger ─────────────────────────────────────────────────────────────────

class MdixMerger:
    """
    Merge two or more `.mdix` sources at the AST level.

    Strategy strings
    ----------------
    Conflict strategy (``with_strategy``):
        ``"weighted_priority"``  — higher-weight source wins (default)
        ``"primary_wins"``       — first source always wins conflicts
        ``"secondary_wins"``     — last source always wins conflicts
        ``"throw_on_conflict"``  — raises ``MdixError`` on any conflict

    Array strategy (``with_array_strategy``):
        ``"replace"``            — one source's array replaces the other
        ``"concat"``             — arrays are joined (duplicates kept)
        ``"concat_dedup"``       — arrays are joined and deduplicated (default)

    Example::

        db = (MdixMerger()
              .with_strategy("primary_wins")
              .merge_strings([
                  ("base",    '@DATA( name = "App" )', 1.0),
                  ("overlay", '@DATA( name = "Alt"  )', 0.5),
              ]))
        # db.get_string("name") == "App"
    """

    def __repr__(self) -> str: ...

    def with_strategy(self, strategy: str) -> MdixMerger: ...
    def with_array_strategy(self, strategy: str) -> MdixMerger: ...

    def merge_files(self, paths: List[str]) -> MdixDatabase: ...
    def merge_files_weighted(
        self, paths_and_weights: List[Tuple[str, float]]
    ) -> MdixDatabase: ...

    def try_merge_files(self, paths: List[str]) -> MdixResult: ...
    def try_merge_files_weighted(
        self, paths_and_weights: List[Tuple[str, float]]
    ) -> MdixResult: ...

    def merge_strings(
        self,
        sources: List[Tuple[str, str, float]],
    ) -> MdixDatabase:
        """
        Merge `.mdix` source text directly without touching disk.

        ``sources`` is a list of ``(label, source_text, weight)`` triples.
        ``label`` is used only in conflict-report messages.
        """
        ...

