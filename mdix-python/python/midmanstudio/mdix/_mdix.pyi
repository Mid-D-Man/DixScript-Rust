    def set_enum(
        self, path: str, enum_name: str, field_name: str
    ) -> MdixBuilder: ...
    def set_array(self, path: str, items: List[Any]) -> MdixBuilder: ...
    def set_tuple(self, path: str, items: List[Any]) -> MdixBuilder: ...
    def set_object(self, path: str, props: dict) -> MdixBuilder: ...

    # ── @DATA tier 2 ─────────────────────────────────────────────────────────

    def with_table_properties(
        self,
        path: str,
        props: Optional[dict] = None,
        **kwargs: Any,
    ) -> MdixBuilder: ...
    def with_group_array(
        self, path: str, items: List[Any]
    ) -> MdixBuilder: ...

    # ── Internal (ML layer) ───────────────────────────────────────────────────

