# ── MdixSchemaBuilder ──────────────────────────────────────────────────────────

class MdixSchemaBuilder:
    """
    Fluent schema definition and validation.

    The same schema instance can be reused across multiple ``validate()``
    calls — it borrows, not consumes.

    Accepted type strings for ``require`` / ``optional``:
        ``"string"``, ``"int"``, ``"long"``, ``"float"``, ``"double"``,
        ``"bool"``, ``"array"``, ``"object"``, ``"date"``, ``"timestamp"``,
        ``"hexcolor"``, ``"blob"``, ``"regex"``, ``"enum"``, ``"any"``

    Example::

        schema = (MdixSchemaBuilder()
                  .require_string("app_name")
                  .require_int("port")
                  .optional_bool("debug"))

        for db in [db_prod, db_staging]:
            report = schema.validate(db)
            if not report.is_valid:
                print(report)
    """

    @property
    def field_count(self) -> int: ...
    @property
    def paths(self) -> List[str]: ...

    # ── require — field must be present with the given type ───────────────────

    def require(self, path: str, expected_type: str) -> MdixSchemaBuilder: ...
    def require_string(self, path: str) -> MdixSchemaBuilder: ...
    def require_int(self, path: str) -> MdixSchemaBuilder: ...
    def require_long(self, path: str) -> MdixSchemaBuilder: ...
    def require_float(self, path: str) -> MdixSchemaBuilder: ...
    def require_double(self, path: str) -> MdixSchemaBuilder: ...
    def require_bool(self, path: str) -> MdixSchemaBuilder: ...
    def require_array(self, path: str) -> MdixSchemaBuilder: ...
    def require_object(self, path: str) -> MdixSchemaBuilder: ...
    def require_enum(self, path: str) -> MdixSchemaBuilder: ...

    # ── optional — field may be absent; if present, type must match ───────────

    def optional(self, path: str, expected_type: str) -> MdixSchemaBuilder: ...
    def optional_string(self, path: str) -> MdixSchemaBuilder: ...
    def optional_int(self, path: str) -> MdixSchemaBuilder: ...
    def optional_long(self, path: str) -> MdixSchemaBuilder: ...
    def optional_float(self, path: str) -> MdixSchemaBuilder: ...
    def optional_double(self, path: str) -> MdixSchemaBuilder: ...
    def optional_bool(self, path: str) -> MdixSchemaBuilder: ...
    def optional_array(self, path: str) -> MdixSchemaBuilder: ...
    def optional_object(self, path: str) -> MdixSchemaBuilder: ...

    # ── Metadata ──────────────────────────────────────────────────────────────

    def with_description(self, description: str) -> MdixSchemaBuilder: ...

    # ── Validation ────────────────────────────────────────────────────────────

    def validate(self, db: MdixDatabase) -> MdixValidationReport: ...

# ── MdixWatcher ────────────────────────────────────────────────────────────────

class MdixWatcher:
    """
    Poll-based hot reload for a `.mdix` file. Call `.check()` from your own
    update loop / tick / timer callback — there's no background thread or
    OS filesystem-event integration here, by design (see `watch.rs`).

    Example::

        watcher = MdixWatcher("config.mdix")

        # in your update loop:
        db, changed = watcher.check()
        if changed:
            apply_new_config(db)
    """

    def __init__(self, path: str) -> None: ...

    def check(self) -> Tuple[Optional[MdixDatabase], bool]:
        """
        Reloads only if the watched file's modified-time has changed since
        the last successful check (or since construction, on the first
        call). Returns `(database_or_none, changed)` — `database` is
        `None` when `changed` is `False`.
        """
        ...
    def force_reload(self) -> MdixDatabase:
        """Reloads unconditionally, regardless of whether the file changed."""
        ...
    def has_changed(self) -> bool:
        """Checks whether the file has changed without reloading it."""
        ...

    @property
    def has_loaded(self) -> bool:
        """`True` once a successful reload has happened at least once."""
        ...
    @property
    def path(self) -> str: ...

    def __repr__(self) -> str: ...

