# ── MdixResult ──────────────────────────────────────────────────────────────────

class MdixResult:
    """
    Railway-oriented result type.

    Use ``bool(result)`` to check success.
    Use ``.value`` / ``.error`` to access the content.
    """

    @classmethod
    def ok(cls, value: Any) -> MdixResult: ...
    @classmethod
    def err(cls, message: str) -> MdixResult: ...

    @property
    def is_success(self) -> bool: ...
    @property
    def is_failure(self) -> bool: ...
    @property
    def value(self) -> Any: ...
    @property
    def error(self) -> str: ...

    def or_raise(self) -> Any: ...
    def unwrap(self) -> Any: ...
    def unwrap_or(self, fallback: Any) -> Any: ...
    def unwrap_or_else(self, factory: Callable[[str], Any]) -> Any: ...

    def map(self, f: Callable[[Any], Any]) -> MdixResult: ...
    def and_then(self, f: Callable[[Any], MdixResult]) -> MdixResult: ...
    def ensure(
        self,
        predicate: Callable[[Any], bool],
        error_message: str,
    ) -> MdixResult: ...
    def or_(self, fallback: MdixResult) -> MdixResult: ...
    def fold(
        self,
        on_success: Callable[[Any], Any],
        on_failure: Callable[[str], Any],
    ) -> Any: ...
    def tap(self, f: Callable[[Any], None]) -> MdixResult: ...
    def tap_error(self, f: Callable[[str], None]) -> MdixResult: ...

    def __bool__(self) -> bool: ...
    def __repr__(self) -> str: ...
    def __class_getitem__(cls, item: Any) -> Any: ...

