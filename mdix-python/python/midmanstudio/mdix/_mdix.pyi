    must come before any ``with_*`` (tier-2 grouped) calls.
    Violating this raises ``MdixError`` immediately.
    """

    def __repr__(self) -> str: ...

    # ── @CONFIG ───────────────────────────────────────────────────────────────

    def set_config(self, key: str, value: str) -> MdixBuilder: ...
