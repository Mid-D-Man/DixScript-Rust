# ── MdixBuilder ────────────────────────────────────────────────────────────────

class MdixBuilder:
    """
    Programmatic `.mdix` builder.

    Two-tier ordering is enforced: all ``set_*`` (tier-1 flat) calls
    must come before any ``with_*`` (tier-2 grouped) calls.
    Violating this raises ``MdixError`` immediately.
    """

    def __repr__(self) -> str: ...

    # ── @CONFIG ───────────────────────────────────────────────────────────────

    def set_config(self, key: str, value: str) -> MdixBuilder: ...
    def add_enum(self, name: str, fields: List[Any]) -> MdixBuilder: ...

    # ── @DATA tier 1 ─────────────────────────────────────────────────────────

    def set_string(self, path: str, value: str) -> MdixBuilder: ...
    def set_int(self, path: str, value: int) -> MdixBuilder: ...
    def set_float(self, path: str, value: float) -> MdixBuilder: ...
    def set_double(self, path: str, value: float) -> MdixBuilder: ...
    def set_bool(self, path: str, value: bool) -> MdixBuilder: ...
    def set_date(self, path: str, value: str) -> MdixBuilder: ...
    def set_timestamp(self, path: str, value: str) -> MdixBuilder: ...
    def set_hex_color(self, path: str, value: str) -> MdixBuilder: ...
    def set_blob(self, path: str, base64_data: str) -> MdixBuilder: ...
    def set_regex(self, path: str, pattern: str) -> MdixBuilder: ...
    def set_enum(
        self, path: str, enum_name: str, field_name: str
    ) -> MdixBuilder: ...
    def set_array(self, path: str, items: List[Any]) -> MdixBuilder: ...
    def set_tuple(self, path: str, items: List[Any]) -> MdixBuilder: ...
    def set_object(self, path: str, props: dict) -> MdixBuilder: ...

    # ── @DATA tier 2 ─────────────────────────────────────────────────────────

    def with_table_properties(
        self,
        path: str,
        props: Optional[dict] = None,
        **kwargs: Any,
    ) -> MdixBuilder: ...
    def with_group_array(
        self, path: str, items: List[Any]
    ) -> MdixBuilder: ...

    # ── Internal (ML layer) ───────────────────────────────────────────────────

    def _with_raw_table_properties(
        self,
        path: str,
        raw_props: List[Tuple[str, str]],
    ) -> MdixBuilder: ...

    # ── Finalization ──────────────────────────────────────────────────────────

    def serialize(self) -> str: ...
    def to_database(self) -> MdixDatabase: ...
    def try_to_database(self) -> MdixResult: ...
    def reset_grouped(self) -> None: ...
    def reset(self) -> None: ...

