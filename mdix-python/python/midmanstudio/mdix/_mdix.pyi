        **kwargs: Any,
    ) -> MdixBuilder: ...
    def with_group_array(
        self, path: str, items: List[Any]
    ) -> MdixBuilder: ...

    # ── Internal (ML layer) ───────────────────────────────────────────────────

    def _with_raw_table_properties(
        self,
