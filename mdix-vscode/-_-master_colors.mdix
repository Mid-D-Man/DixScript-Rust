@CONFIG(
  version -> "1.0.0"
  author  -> "Mid-D-Man"
)

@ENUMS(
  Theme { DARK = 0, LIGHT = 1, HIGH_CONTRAST = 2 }
)
@DATA(
  // Dark theme token colors
  dark:
  keyword   = #569CD6
  string    = #CE9178
  number    = #B5CEA8
  function  = #DCDCAA
  type      = #4EC9B0
  comment   = #6A9955
  namespace = #9CDCFE
  enum      = #C8C8C8
  parameter = #9CDCFE
  decorator = #C586C0

  // Light theme overrides
  light:
  keyword  = #0000FF
  string   = #A31515
  function = #795E26

)  
