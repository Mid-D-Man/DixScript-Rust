{
  "name": "dixscript",
  "displayName": "DixScript (.mdix)",
  "description": "Full IDE support for DixScript — syntax highlighting, completions, hover, goto-definition, diagnostics, inlay hints, formatting, and more.",
  "version": "1.0.0",
  "publisher": "midmanstudio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mid-D-Man/DixScript-Rust"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "dixscript",
    "mdix",
    "config",
    "configuration",
    "data-format"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mdix",
        "aliases": [
          "DixScript",
          "mdix"
        ],
        "extensions": [
          ".mdix"
        ],
        "icon": {
          "light": "./icons/mdix-file-light.svg",
          "dark": "./icons/mdix-file-dark.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mdix",
        "scopeName": "source.mdix",
        "path": "./syntaxes/mdix.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "dixscript.restartServer",
        "title": "DixScript: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "DixScript",
      "properties": {
        "dixscript.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the mdix-lsp binary. Leave empty to use the bundled binary or auto-detection."
        },
        "dixscript.server.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "LSP protocol trace level. Use 'verbose' when reporting bugs."
        },
        "dixscript.server.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra command-line arguments passed to mdix-lsp."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile && node scripts/copy-binary.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  }
}
