@CONFIG(
  version -> "1.0.0"
  author  -> "Mid-D-Man"
)

@DATA(
  project_name    = "DixScript Sample"
  max_connections = 100
  timeout_seconds = 30
  retry_backoff   = 1.5
  debug_enabled   = true

  tags = ["getting-started", "sample", "mdix"]

  // Native VS Code color swatch + picker on this — try it.
  brand_color = #569CD6

  // Click the 📅 lens above either of these.
  release_date   = 2026-08-07
  last_deploy_at = 2026-08-07T14:30:00Z
)
