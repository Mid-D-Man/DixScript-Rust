<Addin>
  <!--
    Tells VS4Mac's MEF container to scan this addin's own assembly for
    [Export] components: specifically MdixLanguageClient (implements
    ILanguageClient) and MdixContentDefinition's exports, both in
    MdixLanguageClient.cs. Without this, the host's Mono.Addins loader picks
    the assembly up fine, but MEF composition (a separate mechanism layered
    on top, not something Mono.Addins does for you automatically) never
    finds those exports, so ILanguageClient never activates for .mdix files
    even though the addin itself loads without error.

    File name matches AssemblyName in MdixAddin.csproj, namely "MdixLanguageSupport" —
    not the class name "MdixLanguageClient" or the project name "MdixAddin".

    Source: Matt Ward's own VS4Mac LSP walkthrough (lastexitcode.com,
    "Language Server Protocol support in Visual Studio for Mac 7.4"),
    "Enabling Managed Extensibility Framework Support" section.
  -->
  <Extension path="/MonoDevelop/Ide/Composition">
    <Assembly file="MdixLanguageSupport.dll" />
  </Extension>

  <Extension path="/MonoDevelop/Core/MimeTypes">
    <MimeType
        id="text/x-mdix"
        _description="DixScript Configuration File"
        icon="md-mdix-file"
        isText="true">
      <File pattern="*.mdix" />
    </MimeType>
  </Extension>

  <!--
    2026-08-03: resource name corrected to mdix-file.svg — the file that
    actually exists in Resources/ (mdix-file-icon.svg never did, which is
    why the .mpack came out at ~7KB: no <Runtime> section here ever declared
    ANY support file as belonging to the addin, so vstool setup pack had
    nothing but the DLL to bundle. That declaration now lives in
    AddinInfo.cs as [assembly: ImportAddinFile(...)] attributes rather than
    a <Runtime> block here — same mechanism, Mono.Addins supports both, this
    project already leans on the attribute style everywhere else.
  -->
  <Extension path="/MonoDevelop/Ide/StockIcons">
    <StockIcon stockid="md-mdix-file" resource="mdix-file.svg" />
  </Extension>

  <Extension path="/MonoDevelop/Ide/FileFilters">
    <FileFilter id="Mdix" _label="DixScript Files" extensions="*.mdix" />
  </Extension>
</Addin>
