<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ROOT CAUSE OF YOUR BUILD ERRORS (#1):
    The old csproj targeted net472 and referenced MonoDevelop.Ide.dll / Mono.Addins.dll
    etc. via <Reference Include="..."><HintPath>...</HintPath></Reference> pointing into
    the Visual Studio.app bundle's MonoBundle folder. That's the pre-2022 (Xamarin
    Studio / "Visual Studio for Mac 8.x") way of doing it, back when the IDE itself ran
    on Mono.

    Visual Studio 2022 for Mac was a ground-up rewrite: the IDE host process itself moved
    off Mono onto .NET 6/7 and the UI moved from GTK to native Cocoa. Addins for that
    generation are built against the official SDK NuGet package instead, which pulls in
    the correct assembly set and build targets for you. Source: Microsoft's own "extending
    VS Mac" walkthrough (christianhelle.com/2023/03/extending-vsmac.html) and the package
    page itself (nuget.org/packages/Microsoft.VisualStudioMac.Sdk).

    Note: the package tops out at 17.5.0 even though the IDE itself shipped up to 17.6
    before Microsoft retired it (EOL Aug 31 2024) — no 17.6-tagged SDK was ever published.
    17.5.0 is the correct/last version to reference.
  -->
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <AssemblyName>MdixLanguageSupport</AssemblyName>
    <RootNamespace>MidManStudio.Mdix</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Safety net, not a substitute for actually deleting the file: as of this
    change MdixLanguageClientProvider.cs is replaced by MdixLanguageClient.cs
    (implements the real ILanguageClient, not a nonexistent base class — see
    that file's own header for the full story). Delete
    MdixLanguageClientProvider.cs from disk when you pull this in. This
    exclusion just means the build doesn't silently regress back to the same
    CS0115/CS0535 pile if it's ever left lying around by accident.
  -->
  <ItemGroup>
    <Compile Remove="MdixLanguageClientProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudioMac.Sdk" Version="17.5.0" />
  </ItemGroup>

  <!--
    NOTE — do NOT add an explicit <EmbeddedResource Include="Manifest.addin.xml" />
    item here. I had one in the first pass of this fix and it broke your build with
    NETSDK1022 ("Duplicate 'EmbeddedResource' items were included"). Turns out
    Microsoft.VisualStudioMac.Sdk's own build targets already glob *.addin.xml files
    into EmbeddedResource by default (confirmed against the reference walkthrough's
    final working csproj, which never adds one either) — Mono.Addins finds the
    manifest at registration time without you doing anything extra. If you ever
    genuinely need to turn default item inclusion off for something else, use
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    rather than fighting it with an explicit duplicate item.
  -->

  <!--
    2026-08-06 — icon Resources block removed (was mdix-file.svg /
    mdix-file-dark.svg). The crash report from the build that used these
    (mdix-vsmac/Issues.txt) showed VS4Mac's own crash monitor FailFasting on
    a native NSException thrown mid-redraw, right after this became the
    first build where the StockIcons extension point path was actually
    correct — i.e. the first time the SVG was genuinely rasterized rather
    than silently skipped. Pulled as a clean isolation test; see the
    comment in Manifest.addin.xml and AddinInfo.cs for the full reasoning.
    If it comes back later, restore this block and the matching
    <StockIcon>/ImportAddinFile entries together.
  -->

  <!--
    2026-08-03 — ROOT CAUSE of the FATAL ERROR during `vstool setup pack`
    ("Could not find a part of the path '.../bin/Release/net7.0/lsp/mdix-lsp'")
    and of the 7KB .mpack: this ItemGroup used Update=, not Include=.

    Update= only attaches metadata (CopyToOutputDirectory, Link) to an item
    that's ALREADY part of the project's item list. bin\ and obj\ are
    excluded from the SDK's default item globbing unconditionally (per
    Microsoft's own docs — "Default includes and excludes" /
    DefaultItemExcludes), so the SDK never adds these files as items in the
    first place, and Update= on a nonexistent item is a silent no-op — no
    warning, no error, it just does nothing.

    Fix: Include= instead of Update=. Explicit Include items are authored by
    us, not produced by the default wildcard glob, so DefaultItemExcludes
    (which only filters the SDK's own implicit **\* glob) never applies to
    them. Confirmed working: unzip -l on the resulting .mpack showed
    lsp/mdix-lsp present at the correct nested path.

    2026-08-06 — added the mdix CLI binary (mdix-cli crate, see its
    Cargo.toml [[bin]] name = "mdix") alongside mdix-lsp here, same fix
    applied to mdix-vscode's copy-binary.js. mdix-lsp's own CLI resolution
    (which_mdix() in mdix-lsp/src/features/commands.rs) checks PATH first,
    then falls back to looking next to its own running executable — landing
    mdix at lsp/mdix, right beside lsp/mdix-lsp, means that fallback finds
    it with nothing else required.

    Condition still guards against the files not existing yet (before
    copy-binary.sh has run). Same packaging note as before: being copied to
    the output directory is necessary but not sufficient — see the
    [assembly: ImportAddinFile(...)] declarations in AddinInfo.cs, which are
    what actually makes vstool setup pack include these once they're really
    sitting at bin/<config>/net7.0/lsp/.
  -->
  <ItemGroup>
    <None Include="bin\darwin-arm64\mdix-lsp" Condition="Exists('bin\darwin-arm64\mdix-lsp')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>lsp\mdix-lsp</Link>
    </None>
    <None Include="bin\darwin-x64\mdix-lsp" Condition="Exists('bin\darwin-x64\mdix-lsp')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>lsp\mdix-lsp</Link>
    </None>
    <None Include="bin\darwin-arm64\mdix" Condition="Exists('bin\darwin-arm64\mdix')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>lsp\mdix</Link>
    </None>
    <None Include="bin\darwin-x64\mdix" Condition="Exists('bin\darwin-x64\mdix')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>lsp\mdix</Link>
    </None>
  </ItemGroup>

  <!--
    Optional: lets you hit F5 / `dotnet run` from Rider or VS to launch a real VS4Mac
    instance with this addin loaded for interactive testing, instead of reinstalling the
    .mpack every time you change something. Harmless if you never use it.
  -->
  <PropertyGroup Condition=" '$(RunConfiguration)' == 'Default' ">
    <StartAction>Program</StartAction>
    <StartProgram>/Applications/Visual Studio.app/Contents/MacOS/VisualStudio</StartProgram>
    <StartArguments>--no-redirect</StartArguments>
    <ExternalConsole>true</ExternalConsole>
  </PropertyGroup>

</Project>
