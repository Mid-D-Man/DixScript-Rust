<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ROOT CAUSE OF YOUR BUILD ERRORS (#1):
    The old csproj targeted net472 and referenced MonoDevelop.Ide.dll / Mono.Addins.dll
    etc. via <Reference Include="..."><HintPath>...</HintPath></Reference> pointing into
    the Visual Studio.app bundle's MonoBundle folder. That's the pre-2022 (Xamarin
    Studio / "Visual Studio for Mac 8.x") way of doing it, back when the IDE itself ran
    on Mono.

    Visual Studio 2022 for Mac was a ground-up rewrite: the IDE host process itself moved
    off Mono onto .NET 6/7 and the UI moved from GTK to native Cocoa. Addins for that
    generation are built against the official SDK NuGet package instead, which pulls in
    the correct assembly set and build targets for you. Source: Microsoft's own "extending
    VS Mac" walkthrough (christianhelle.com/2023/03/extending-vsmac.html) and the package
    page itself (nuget.org/packages/Microsoft.VisualStudioMac.Sdk).

    Note: the package tops out at 17.5.0 even though the IDE itself shipped up to 17.6
    before Microsoft retired it (EOL Aug 31 2024) — no 17.6-tagged SDK was ever published.
    17.5.0 is the correct/last version to reference.
  -->
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <AssemblyName>MdixLanguageSupport</AssemblyName>
    <RootNamespace>MidManStudio.Mdix</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Safety net, not a substitute for actually deleting the file: as of this
    change MdixLanguageClientProvider.cs is replaced by MdixLanguageClient.cs
    (implements the real ILanguageClient, not a nonexistent base class — see
    that file's own header for the full story). Delete
    MdixLanguageClientProvider.cs from disk when you pull this in. This
    exclusion just means the build doesn't silently regress back to the same
    CS0115/CS0535 pile if it's ever left lying around by accident.
  -->
  <ItemGroup>
    <Compile Remove="MdixLanguageClientProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudioMac.Sdk" Version="17.5.0" />
  </ItemGroup>

  <!--
    NOTE — do NOT add an explicit <EmbeddedResource Include="Manifest.addin.xml" />
    item here. I had one in the first pass of this fix and it broke your build with
    NETSDK1022 ("Duplicate 'EmbeddedResource' items were included"). Turns out
    Microsoft.VisualStudioMac.Sdk's own build targets already glob *.addin.xml files
    into EmbeddedResource by default (confirmed against the reference walkthrough's
    final working csproj, which never adds one either) — Mono.Addins finds the
    manifest at registration time without you doing anything extra. If you ever
    genuinely need to turn default item inclusion off for something else, use
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    rather than fighting it with an explicit duplicate item.
  -->

  <!--
    ROOT CAUSE OF YOUR BUILD ERRORS (#2):
    Manifest.addin.xml's <StockIcon> extension pointed at mdix-file-icon.svg /
    mdix-file-icon-dark.svg, and the old csproj had <None Include="Resources\...svg">
    entries for them — but no Resources folder, and no SVGs, ever actually existed in
    mdix-vsmac. That's a guaranteed "file not found" at build time.

    2026-08-03 update: the actual files that got added to Resources/ landed as
    mdix-file.svg / mdix-file-dark.svg (no "-icon" in the name) — updated the
    references below and in Manifest.addin.xml to match, rather than re-renaming
    the files again.

    Using Update= here, not Include=: the same default-item-globbing that bit the
    Manifest.addin.xml EmbeddedResource item above also applies to None items — the SDK
    auto-includes arbitrary files under the project directory (svg, json, extensionless
    binaries, etc.) as None by default. Include= would double-declare them and throw the
    same NETSDK1022 you just hit; Update= just attaches CopyToOutputDirectory metadata to
    the item the SDK already added, without re-adding it.

    Note: copying these to the output directory is necessary but not sufficient for
    them to end up in the .mpack — vstool setup pack only bundles files the addin
    manifest actually declares as belonging to it. That declaration now lives in
    AddinInfo.cs as [assembly: ImportAddinFile(...)] attributes.
  -->
  <ItemGroup>
    <None Update="Resources\mdix-file.svg" Condition="Exists('Resources\mdix-file.svg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\mdix-file-dark.svg" Condition="Exists('Resources\mdix-file-dark.svg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    The mdix-lsp binary, dropped in by scripts/copy-binary.sh before packing (same
    bin/<platform>/mdix-lsp layout the VS Code extension uses). Update=, same reasoning
    as above: these are default-included as None already once the file exists on disk.
    Condition guards against the file not existing yet (before copy-binary.sh has run).

    Same packaging note as the icons above: being copied to the output directory
    doesn't get this into the .mpack by itself — see the [assembly: ImportAddinFile
    ("lsp/mdix-lsp")] declaration in AddinInfo.cs, which is what actually makes
    vstool setup pack include it.
  -->
  <ItemGroup>
    <None Update="bin\darwin-arm64\mdix-lsp" Condition="Exists('bin\darwin-arm64\mdix-lsp')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>lsp\mdix-lsp</Link>
    </None>
    <None Update="bin\darwin-x64\mdix-lsp" Condition="Exists('bin\darwin-x64\mdix-lsp')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>lsp\mdix-lsp</Link>
    </None>
  </ItemGroup>

  <!--
    Optional: lets you hit F5 / `dotnet run` from Rider or VS to launch a real VS4Mac
    instance with this addin loaded for interactive testing, instead of reinstalling the
    .mpack every time you change something. Harmless if you never use it.
  -->
  <PropertyGroup Condition=" '$(RunConfiguration)' == 'Default' ">
    <StartAction>Program</StartAction>
    <StartProgram>/Applications/Visual Studio.app/Contents/MacOS/VisualStudio</StartProgram>
    <StartArguments>--no-redirect</StartArguments>
    <ExternalConsole>true</ExternalConsole>
  </PropertyGroup>

</Project>
