.{
    .name = .mdix_zig,
    .version = "0.1.0",

    // Together with .name, this represents a globally unique package
    // identifier. The high 32 bits are a checksum of .name (that's why
    // both values the compiler offered on the two CI runs shared the
    // "0x1a8d210e" prefix); the low 32 bits are a random id. Taken
    // verbatim from the compiler's own suggestion (CI run #1's
    // build-and-test job, test-ffi step) rather than hand-rolled — if
    // .name ever changes, this needs regenerating (delete the field,
    // run `zig build`, paste in what it suggests).
    .fingerprint = 0x1a8d210ea8e42264,

    .minimum_zig_version = "0.16.0",

    .dependencies = .{},

    // FIX: "mdix" was missing from this list. build.zig's `mdix` module
    // (b.addModule("mdix", .{ .root_source_file = b.path("mdix/mdix.zig") }))
    // and its tests (mdix/tests/tests.zig) both live under mdix/, but only
    // mdix_ffi was declared here. `zig fetch` only copies declared `.paths`
    // into a consumer's local package cache — anyone depending on this
    // package via a tagged ref or tarball URL would have had mdix/ silently
    // stripped, and `@import("mdix")` would fail to resolve on their end
    // despite building fine in-repo. Confirmed directly against build.zig's
    // actual b.addModule()/b.path() calls, not assumed.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "mdix_ffi",
        "mdix",
        "examples",
        "README.md",
    },
}
