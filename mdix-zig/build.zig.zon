.{
    .name = .mdix_zig,
    .version = "0.1.0",

    // Together with .name, this represents a globally unique package
    // identifier — generated by the Zig toolchain and then never
    // changed. Left unset here since no `zig build` has run against this
    // manifest yet in this environment (execution here is limited to
    // Rust ~1.75 and Zig isn't part of that toolchain — see the repo's
    // execution-constraints notes). Run `zig build` once locally; the
    // compiler will refuse to proceed without a fingerprint and print
    // the exact line to paste in here (see
    // https://ziglang.org/documentation/master/#Fingerprint). Do not
    // hand-roll a value — an incorrect fingerprint is worse than a
    // missing one.
    // .fingerprint = 0x0000000000000000,

    .minimum_zig_version = "0.16.0",

    .dependencies = .{},

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "mdix_ffi",
        "examples",
        "README.md",
    },
}
