@CONFIG(
  version -> "1.0.0",
  author -> "GameStudio",
  features -> "advanced",
  error_handling -> "halt"
)

@ENUMS(
  Difficulty { EASY, NORMAL, HARD, EXTREME, NIGHTMARE }
  Rarity { COMMON, UNCOMMON, RARE, EPIC, LEGENDARY }
  ShopType { WEAPONS_AND_ARMOR, POTIONS, GENERAL, MAGIC_ITEMS }
  PlayerClass { WARRIOR, MAGE, ROGUE, HEALER }
)
//can use comments but they increase file size so keep em mnimal
@QUICKFUNCS(
  // Calculate actual spawn count
  ~calculateSpawns<int> (base<int>, difficulty<enum>) {
   let multiplier = difficulty == Difficulty.EASY ? 0.5 :
                            difficulty == Difficulty.NORMAL ? 1.0 :
                            difficulty == Difficulty.HARD ? 1.5 :
                            difficulty == Difficulty.EXTREME ? 2.0 : 3.0;
    return Math.round(base * multiplier);
    
  }
  
  // Create enemy spawn entry
  ~createSpawn<object> (id<string>, level<int>, chance<float>, count<int>, respawn<int>) {
    return {
      enemyId = id,
      level = level,
      spawnChance = chance,
      maxCount = count,
      respawnTime = respawn
    };
  }
  
  // Create loot drop entry
  ~createLoot<object> (id<string>, chance<float>, minQty<int>, maxQty<int>) {
    return {
      itemId = id,
      dropChance = chance,
      minQuantity = minQty,
      maxQuantity = maxQty
    };
  }
  
  // Create crafting recipe
  ~createRecipe<object> (id<string>, result<string>, qty<int>, level<int>, gold<int>, time<int>) {
    return {
      recipeId = id,
      resultItem = result,
      resultQuantity = qty,
      requiredLevel = level,
      requiredGold = gold,
      craftingTime = time
    };
  }
  
  // Create shop item
  ~createShopItem<object> (id<string>, price<int>, stock<int>, restock<int>) {
    return {
      itemId = id,
      price = price,
      stock = stock,
      restockTime = restock
    };
  }
  
  // Create skill entry
  ~createSkill<object> (id<string>, name<string>, maxLvl<int>, baseDmg<int>, dmgPerLvl<int>, mana<int>, cd<int>, reqLvl<int>) {
    return {
      skillId = id,
      name = name,
      maxLevel = maxLvl,
      baseDamage = baseDmg,
      damagePerLevel = dmgPerLvl,
      manaCost = mana,
      cooldown = cd,
      requiredLevel = reqLvl
    };
  }
)

