@CONFIG(
  version -> "1.0.0",
  features -> "advanced"
)

@ENUMS(
  CamoRarity { BASIC, RARE, EPIC, LEGENDARY }
  CamoType { SPRITE, SPRITE_AND_MATERIAL, MATERIAL }
  ItemClass { BASIC_SMG, TACTICAL_SMG, ASSAULT_RIFLE, SNIPER }
)

@QUICKFUNCS(
  ~createCamo<object> (id<string>, idx<int>, season<string>, rarity<enum>, sprite<string>, name<string>, type<enum>) {
    return {
      CamoId = id,
      CamoIndex = idx,
      CamoAvailableInSeason = season,
      CamoRarity = rarity,
      CamoAtlasSpriteName = sprite,
      CamoInGameName = name,
      CamoType = type,
      MaterialAddress = "Null"
    };
  }
  
  ~createCamoWithAttainment<object> => global(id<string>, idx<int>, season<string>, rarity<enum>, sprite<string>, name<string>, type<enum>, attType<string>) {
    return {
      CamoId = id,
      CamoIndex = idx,
      CamoAttainmentType = attType,
      CamoAvailableInSeason = season,
      CamoRarity = rarity,
      CamoAtlasSpriteName = sprite,
      CamoInGameName = name,
      CamoType = type,
      MaterialAddress = "Null"
    };
  }
  
  ~createCamoWithCurrency<object> => global(id<string>, idx<int>, season<string>, rarity<enum>, sprite<string>, name<string>, type<enum>, attType<string>, curr<string>, amt<int>) {
    return {
      CamoId = id,
      CamoIndex = idx,
      CamoAttainmentType = attType,
      CamoAttainmentCurrency = curr,
      CamoAttainmentCurrencyAmount = amt,
      CamoAvailableInSeason = season,
      CamoRarity = rarity,
      CamoAtlasSpriteName = sprite,
      CamoInGameName = name,
      CamoType = type,
      MaterialAddress = "Null"
    };
  }
)

