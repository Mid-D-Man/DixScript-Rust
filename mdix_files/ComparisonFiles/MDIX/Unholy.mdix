  ) product_reviews:review_001 = review("REV-2025-00001", "PROD-LAPT-001", "CUST-001-2024", "ORD-2025-00001", 5, "Exceptional Gaming Performance", "This laptop exceeds all expectations! The RTX 4090 handles every game at max settings with ease. The 240Hz display is incredibly smooth, and the build quality is top-notch. Battery life is decent for a gaming laptop. Highly recommended for serious gamers.", ["Excellent GPU performance", "Beautiful high refresh display", "Great cooling system", "Premium build quality"], ["Heavy to carry around", "Price is high", "Fans can be loud under load"], true, 45, 2, "2025-01-08T18:30:00Z", merchantResp("Thank you for the amazing review! We're thrilled you're enjoying your new gaming laptop. Happy gaming!", "TechMart Support Team", "2025-01-09T10:00:00Z"))
  
 review_002 = review("REV-2025-00002", "PROD-ACC-COOL-001", "CUST-002-2024", "ORD-2024-00156", 4, "Good cooling, great RGB", "The cooling pad works well and keeps my laptop temperatures down by about 10-15 degrees. The RGB lighting is vibrant and customizable. My only complaint is that it's a bit bulky to travel with.", ["Effective cooling", "Beautiful RGB effects", "Quiet operation", "Adjustable height"], ["Bulky size", "USB cable could be longer"], true, 28, 1, "2024-12-20T15:45:00Z", merchantResp("Thanks for your feedback! We're glad it's keeping your laptop cool. We'll pass along your cable length suggestion to our product team.", "TechMart Support Team", "2024-12-21T09:30:00Z"))
  
 review_003 = review("REV-2025-00003", "PROD-MON-001", "CUST-003-2024", "ORD-2025-00003", 5, "Best monitor I've ever owned", "Absolutely stunning display! The 4K resolution at 240Hz is a game changer. Colors are incredibly accurate, and the HDR1000 makes movies look amazing. G-Sync Ultimate works flawlessly. Worth every penny.", ["Incredible image quality", "Smooth 240Hz refresh", "HDR1000 is stunning", "Excellent build quality", "Great stand adjustability"], ["Expensive", "Takes up desk space"], true, 67, 3, "2025-01-10T20:15:00Z", null)
  
