//note this could easily be further reduced maybe even surpass 70 percent reduction but ehm I don't feel like it 

@CONFIG(
  version -> "1.0.0",
  features -> "advanced"
)

@ENUMS(
  Currency { USD, EUR, GBP, JPY, AUD }
  Language { EN, ES, FR, DE, JA }
  PaymentType { CREDIT_CARD, PAYPAL, APPLE_PAY, GOOGLE_PAY, CRYPTO }
  CardBrand { VISA, MASTERCARD, AMEX, DISCOVER }
  ShippingClass { STANDARD, EXPEDITED, OVERNIGHT, OVERSIZED }
  OrderStatus { PENDING, PROCESSING, SHIPPED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED }
  AccountType { STANDARD, PREMIUM }
  AccountStatus { ACTIVE, INACTIVE, SUSPENDED }
  PanelType { IPS, VA, OLED, TN }
  DayOfWeek { MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY }
)

@QUICKFUNCS(
  ~coords<object>(lat<float>, lon<float>) {
    return { latitude = lat, longitude = lon };
  }

  ~address<object>(street<string>, suite<string>, city<string>, state<string>, zip<string>, country<string>, coords<object>) {
    return {
      street = street,
      suite = suite,
      city = city,
      state = state,
      postal_code = zip,
      country = country,
      coordinates = coords
    };
  }

  ~shipAddr<object>(id<string>, is_def<bool>, label<string>, recipient<string>, street<string>, suite<string>, city<string>, state<string>, zip<string>, country<string>, phone<string>, inst<string>, coords<object>) {
    return {
      address_id = id,
      is_default = is_def,
      label = label,
      recipient_name = recipient,
      street_line_1 = street,
      street_line_2 = suite,
      city = city,
      state = state,
      postal_code = zip,
      country = country,
      phone = phone,
      delivery_instructions = inst,
      coordinates = coords
    };
  }

  ~phones<object>(main<string>, support<string>, intl<string>) {
    return { main = main, support = support, international = intl };
  }

  ~creditCard<object>(id<string>, is_def<bool>, card_type<string>, last_four<string>, exp_month<int>, exp_year<int>, holder<string>, billing_addr_id<string>, verified<bool>, added<string>) {
    return {
      payment_method_id = id,
      is_default = is_def,
      card_type = card_type,
      last_four_digits = last_four,
      expiry_month = exp_month,
      expiry_year = exp_year,
      cardholder_name = holder,
      billing_address_id = billing_addr_id,
      is_verified = verified,
      added_date = added
    };
  }

  ~paypal<object>(id<string>, email<string>, verified<bool>, added<string>) {
    return {
      payment_method_id = id,
      email = email,
      is_verified = verified,
      added_date = added
    };
  }

  ~shipMethod<object>(name<string>, base<float>, per_lb<float>, days_min<int>, days_max<int>, free_thresh<float>, track<bool>, insure<bool>, sign<bool>) {
    return {
      name = name,
      base_cost = base,
      cost_per_pound = per_lb,
      estimated_days_min = days_min,
      estimated_days_max = days_max,
      free_shipping_threshold = free_thresh,
      tracking_included = track,
      insurance_included = insure,
      signature_required = sign
    };
  }

  ~intlShip<object>(name<string>, base<float>, per_lb<float>, days_min<int>, days_max<int>, free_thresh<float>, customs<bool>) {
    return {
      name = name,
      base_cost = base,
      cost_per_pound = per_lb,
      estimated_days_min = days_min,
      estimated_days_max = days_max,
      free_shipping_threshold = free_thresh,
      tracking_included = true,
      insurance_included = true,
      signature_required = customs,
      customs_declaration_required = customs
    };
  }

  ~whStock<object>(wh_id<string>, qty<int>, reserved<int>, incoming<int>, incoming_date<string>, aisle<string>, shelf<string>, bin<string>) {
   let available = qty - reserved;
    return {
      warehouse_id = wh_id,
      stock = {
        quantity = qty,
        reserved = reserved,
        available = available,
        incoming = incoming,
        incoming_date = incoming_date
      },
      location_in_warehouse = {
        aisle = aisle,
        shelf = shelf,
        bin = bin
      }
    };
  }

  ~whLoc<object>(id<string>, name<string>, street<string>, city<string>, state<string>, zip<string>, country<string>) {
    return {
      warehouse_id = id,
      location = {
        name = name,
        street = street,
        city = city,
        state = state,
        postal_code = zip,
        country = country
      }
    };
  }

  ~img<object>(url<string>, alt<string>, img_type<string>, order<int>, w<int>, h<int>) {
    return { url = url, alt = alt, type = img_type, order = order, width = w, height = h };
  }

  ~video<object>(url<string>, title<string>, duration<int>, thumb<string>) {
    return { url = url, title = title, duration_seconds = duration, thumbnail = thumb };
  }

  ~ratingDist<object>(five<int>, four<int>, three<int>, two<int>, one<int>) {
    return { "5_star" = five, "4_star" = four, "3_star" = three, "2_star" = two, "1_star" = one };
  }

  ~warranty<object>(duration<int>, w_type<string>, coverage<array>, exclusions<array>) {
    return {
      duration_months = duration,
      type = w_type,
      coverage = coverage,
      exclusions = exclusions
    };
  }

  ~extWarranty<object>(duration<int>, price<float>, coverage<array>, deduct<float>) {
    return {
      duration_months = duration,
      price = price,
      coverage = coverage,
      deductible = deduct
    };
  }

  ~priceHist<object>(date_<string>, price<float>, reason<string>) {
    return { _date = date_, price = price, reason = reason };
  }

  ~volDisc<object>(min<int>, max<int>, disc<float>) {
    return { quantity_min = min, quantity_max = max, discount_percent = disc };
  }

  ~orderItem<object>(item_id<string>, prod_id<string>, sku<string>, name<string>, qty<int>, unit_price<float>, disc<float>, tax<float>, wh_id<string>, warranty<object>) {
   let subtotal = unit_price * qty;
   let  total = subtotal + tax - disc;
    return {
      order_item_id = item_id,
      product_id = prod_id,
      sku = sku,
      name = name,
      quantity = qty,
      unit_price = unit_price,
      discount_per_item = disc,
      tax_per_item = tax,
      subtotal = subtotal,
      total = total,
      warehouse_id = wh_id,
      warranty_selected = warranty
    };
  }

  ~shipStatus<object>(status<string>, _timestamp<string>, location<string>, notes<string>) {
    return { status = status, timestamp_ = _timestamp, location = location, notes = notes };
  }

  ~review<object>(rev_id<string>, prod_id<string>, cust_id<string>, ord_id<string>, rating<int>, title<string>, text<string>, pros<array>, cons<array>, verified<bool>, helpful<int>, not_help<int>, created<string>, merchant_resp<object>) {
    return {
      review_id = rev_id,
      product_id = prod_id,
      customer_id = cust_id,
      order_id = ord_id,
      rating = rating,
      title = title,
      review_text = text,
      pros = pros,
      cons = cons,
      verified_purchase = verified,
      helpful_count = helpful,
      not_helpful_count = not_help,
      status = "published",
      created_at = created,
      updated_at = created,
      merchant_response = merchant_resp
    };
  }

  ~merchantResp<object>(resp_text<string>, resp_by<string>, resp_at<string>) {
    return { response_text = resp_text, responded_by = resp_by, responded_at = resp_at };
  }

  ~bizHours<object>(open<string>, close<string>, lunch_obj<object>) {
    return { open = open, close = close, lunch_break = lunch_obj };
  }

  ~lunchBreak<object>(start<string>, end<string>) {
    return { start = start, end = end };
  }

  ~paymentConfig<object>(enabled<bool>, types<array>, fee_pct<float>, fee_fixed<float>, min<float>, max<float>, refund_obj<object>) {
    return {
      enabled = enabled,
      accepted_types = types,
      processing_fee_percent = fee_pct,
      processing_fee_fixed = fee_fixed,
      minimum_amount = min,
      maximum_amount = max,
      refund_policy = refund_obj
    };
  }

  ~cryptoPayment<object>(enabled<bool>, coins<array>, fee_pct<float>, min<float>, max<float>, refund_obj<object>) {
    return {
      enabled = enabled,
      accepted_coins = coins,
      processing_fee_percent = fee_pct,
      processing_fee_fixed = 0.00,
      minimum_amount = min,
      maximum_amount = max,
      refund_policy = refund_obj
    };
  }

  ~refundPolicy<object>(full<int>, partial<int>, restock<float>) {
    return {
      full_refund_days = full,
      partial_refund_days = partial,
      restocking_fee_percent = restock
    };
  }

  ~seoMeta<object>(title<string>, desc<string>, keywords<array>) {
    return {
      meta_title = title,
      meta_description = desc,
      meta_keywords = keywords
    };
  }

  ~category<object>(id<string>, name<string>, slug<string>, desc<string>, parent<string>, level<int>, order<int>, active<bool>, seo<object>) {
    return {
      id = id,
      name = name,
      slug = slug,
      description = desc,
      parent_id = parent,
      level = level,
      display_order = order,
      is_active = active,
      seo = seo
    };
  }

  ~brand<object>(id<string>, name<string>, country<string>, founded<int>, website<string>) {
    return { id = id, name = name, country = country, founded = founded, website = website };
  }

  ~prodDesc<object>(short<string>, long<string>, features<array>) {
    return { short = short, long = long, features = features };
  }

  ~processor<object>(brand<string>, model<string>, gen<string>, cores<int>, threads<int>, base_ghz<float>, boost_ghz<float>, cache_mb<int>, tdp<int>) {
    return {
      brand = brand,
      model = model,
      generation = gen,
      cores = cores,
      threads = threads,
      base_clock_ghz = base_ghz,
      boost_clock_ghz = boost_ghz,
      cache_mb = cache_mb,
      tdp_watts = tdp
    };
  }

  ~graphics<object>(brand<string>, model<string>, vram_gb<int>, vram_type<string>, cuda<int>, base_mhz<int>, boost_mhz<int>, rt<bool>, dlss<string>) {
    return {
      brand = brand,
      model = model,
      vram_gb = vram_gb,
      vram_type = vram_type,
      cuda_cores = cuda,
      base_clock_mhz = base_mhz,
      boost_clock_mhz = boost_mhz,
      ray_tracing = rt,
      dlss_version = dlss
    };
  }

  ~memory<object>(cap_gb<int>, mem_type<string>, speed_mhz<int>, slots<int>, max_gb<int>, upgradeable<bool>) {
    return {
      capacity_gb = cap_gb,
      type = mem_type,
      speed_mhz = speed_mhz,
      slots = slots,
      max_capacity_gb = max_gb,
      upgradeable = upgradeable
    };
  }

  ~storagePrimary<object>(cap_gb<int>, stor_type<string>, interface<string>, read_mbps<int>, write_mbps<int>, form<string>) {
    return {
      capacity_gb = cap_gb,
      type = stor_type,
      interface = interface,
      read_speed_mbps = read_mbps,
      write_speed_mbps = write_mbps,
      form_factor = form
    };
  }

  ~storageSlot<object>(slot_num<int>, slot_type<string>, interface<string>, occupied<bool>) {
    return {
      slot_number = slot_num,
      type = slot_type,
      interface = interface,
      occupied = occupied
    };
  }

  ~display<object>(size<float>, res_obj<object>, refresh<int>, response<int>, panel<string>, brightness<int>, gamut_obj<object>, features<array>) {
    return {
      size_inches = size,
      resolution = res_obj,
      refresh_rate_hz = refresh,
      response_time_ms = response,
      panel_type = panel,
      brightness_nits = brightness,
      color_gamut = gamut_obj,
      features = features
    };
  }

  ~resolution<object>(w<int>, h<int>, name<string>) {
    return { width = w, height = h, name = name };
  }

  ~colorGamut<object>(srgb<int>, adobe<int>, dci<int>) {
    return { srgb_percent = srgb, adobe_rgb_percent = adobe, dci_p3_percent = dci };
  }

  ~wifi<object>(standard<string>, speed<int>, bands<array>) {
    return { standard = standard, speed_mbps = speed, bands = bands };
  }

  ~bluetooth<object>(ver<string>, range<int>) {
    return { version = ver, range_meters = range };
  }

  ~hdmiPort<object>(count<int>, ver<string>) {
    return { count = count, version = ver };
  }

  ~ethPort<object>(count<int>, speed_gbps<float>) {
    return { count = count, speed_gbps = speed_gbps };
  }

  ~sdCard<object>(included<bool>, card_type<string>) {
    return { included = included, type = card_type };
  }

  ~battery<object>(cap_wh<int>, cells<int>, bat_type<string>, life_hrs<int>, charge_obj<object>) {
    return {
      capacity_wh = cap_wh,
      cells = cells,
      type = bat_type,
      life_hours = life_hrs,
      charging = charge_obj
    };
  }

  ~charging<object>(power<int>, fast<bool>, time_hrs<float>) {
    return { power_watts = power, fast_charge = fast, charge_time_hours = time_hrs };
  }

  ~dimensions<object>(w<int>, d<int>, h<float>, weight<float>) {
    return { width_mm = w, depth_mm = d, height_mm = h, weight_kg = weight };
  }

  ~os<object>(name<string>, ver<string>, arch<string>, lic<string>) {
    return { name = name, version = ver, architecture = arch, license_type = lic };
  }

  ~pricing<object>(base<float>, curr<string>, disc_obj<object>, final<float>, msrp<float>, cost<float>, margin<float>, tax_class<string>, hist<array>) {
    return {
      base_price = base,
      currency = curr,
      discounts = disc_obj,
      final_price = final,
      msrp = msrp,
      cost = cost,
      margin_percent = margin,
      tax_class = tax_class,
      price_history = hist
    };
  }

  ~currentDisc<object>(disc_type<string>, val<float>, start<string>, end<string>, reason<string>) {
    return {
      type = disc_type,
      value = val,
      start_date = start,
      end_date = end,
      reason = reason
    };
  }

  ~discounts<object>(current<object>, volume<array>) {
    return { current_discount = current, volume_discounts = volume };
  }

  ~inventory<object>(warehouses<object>, alerts<object>) {
    return { warehouses = warehouses, stock_alerts = alerts };
  }

  ~stockAlerts<object>(low<int>, out<int>, over<int>, reorder<int>, reorder_qty<int>) {
    return {
      low_stock_threshold = low,
      out_of_stock_threshold = out,
      overstocked_threshold = over,
      reorder_point = reorder,
      reorder_quantity = reorder_qty
    };
  }

  ~shipping<object>(weight<float>, dims<object>, pkg_type<string>, fragile<bool>, sign<bool>, ship_class<string>, handle_days<int>) {
    return {
      weight_kg = weight,
      dimensions = dims,
      package_type = pkg_type,
      fragile = fragile,
      requires_signature = sign,
      shipping_class = ship_class,
      handling_time_days = handle_days
    };
  }

  ~shipDims<object>(len<int>, wid<int>, hgt<int>) {
    return { length_cm = len, width_cm = wid, height_cm = hgt };
  }

  ~media<object>(images<array>, videos<array>) {
    return { images = images, videos = videos };
  }

  ~reviews<object>(avg<float>, total<int>, dist<object>) {
    return {
      average_rating = avg,
      total_reviews = total,
      rating_distribution = dist
    };
  }

  ~prodWarranty<object>(mfr<object>, ext_options<array>) {
    return {
      manufacturer_warranty = mfr,
      extended_warranty_options = ext_options
    };
  }

  ~customer<object>(id<string>, status<string>, acc_type<string>, joined<string>, last_login<string>, personal<object>, addrs<object>, payments<object>, stats<object>, prefs<object>) {
    return {
      customer_id = id,
      account_status = status,
      account_type = acc_type,
      joined_date = joined,
      last_login = last_login,
      personal_info = personal,
      addresses = addrs,
      payment_methods = payments,
      account_statistics = stats,
      preferences = prefs
    };
  }

  ~personalInfo<object>(first<string>, last<string>, email<string>, phone<object>, dob<string>, gender<string>, lang<string>, newsletter<bool>) {
    return {
      first_name = first,
      last_name = last,
      email = email,
      phone = phone,
      date_of_birth = dob,
      gender = gender,
      preferred_language = lang,
      newsletter_subscribed = newsletter
    };
  }

  ~phoneInfo<object>(primary<string>, secondary<string>, verified<bool>) {
    return { primary = primary, secondary = secondary, verified = verified };
  }

  ~custAddresses<object>(billing<object>, shipping<array>) {
    return { billing = billing, shipping = shipping };
  }

  ~custPayments<object>(cards<array>, paypal_obj<object>) {
    return { credit_cards = cards, paypal = paypal_obj };
  }

  ~custStats<object>(orders<int>, spent<float>, avg<float>, lifetime<float>, points<int>, referrals<int>, reviews<int>, wishlist<int>) {
    return {
      total_orders = orders,
      total_spent = spent,
      average_order_value = avg,
      lifetime_value = lifetime,
      loyalty_points = points,
      referrals = referrals,
      reviews_written = reviews,
      wishlist_items = wishlist
    };
  }

  ~custPrefs<object>(email_notifs<object>, sms_notifs<object>, marketing<object>) {
    return {
      email_notifications = email_notifs,
      sms_notifications = sms_notifs,
      marketing_preferences = marketing
    };
  }

  ~emailNotifs<object>(order_updates<bool>, promos<bool>, recs<bool>, price_drops<bool>, newsletter<bool>) {
    return {
      order_updates = order_updates,
      promotions = promos,
      product_recommendations = recs,
      price_drops = price_drops,
      newsletter = newsletter
    };
  }

  ~smsNotifs<object>(order_updates<bool>, delivery<bool>, promos<bool>) {
    return {
      order_updates = order_updates,
      delivery_alerts = delivery,
      promotions = promos
    };
  }

  ~marketingPrefs<object>(personalized<bool>, third_party<bool>) {
    return {
      personalized_ads = personalized,
      third_party_sharing = third_party
    };
  }

  ~order<object>(ord_id<string>, ord_num<string>, cust_id<string>, status<string>, created<string>, updated<string>, payment<object>, shipping_obj<object>, items<array>, summary<object>, notes<object>, metadata<object>) {
    return {
      order_id = ord_id,
      order_number = ord_num,
      customer_id = cust_id,
      status = status,
      created_at = created,
      updated_at = updated,
      payment = payment,
      shipping = shipping_obj,
      items = items,
      order_summary = summary,
      notes = notes,
      metadata = metadata
    };
  }

  ~payment<object>(pay_id<string>, method_id<string>, method<string>, card_type<string>, last_four<string>, amount<float>, curr<string>, status<string>, txn_id<string>, auth_code<string>, processed<string>, breakdown<object>) {
    return {
      payment_id = pay_id,
      payment_method_id = method_id,
      payment_method = method,
      card_type = card_type,
      last_four_digits = last_four,
      amount = amount,
      currency = curr,
      status = status,
      transaction_id = txn_id,
      authorization_code = auth_code,
      processed_at = processed,
      breakdown = breakdown
    };
  }

  ~paymentBreakdown<object>(subtotal<float>, shipping<float>, tax<float>, disc<float>, total<float>) {
    return {
      subtotal = subtotal,
      shipping = shipping,
      tax = tax,
      discount = disc,
      total = total
    };
  }

  ~orderShipping<object>(ship_addr<object>, method<object>, history<array>) {
    return {
      shipping_address = ship_addr,
      shipping_method = method,
      status_history = history
    };
  }

  ~shipMethodInfo<object>(method_id<string>, name<string>, carrier<string>, days<int>, cost<float>, tracking<string>, track_url<string>) {
    return {
      method_id = method_id,
      name = name,
      carrier = carrier,
      estimated_days = days,
      cost = cost,
      tracking_number = tracking,
      tracking_url = track_url
    };
  }

  ~orderSummary<object>(item_count<int>, total_qty<int>, subtotal<float>, ship<float>, tax<float>, disc<float>, grand<float>) {
    return {
      item_count = item_count,
      total_quantity = total_qty,
      subtotal = subtotal,
      shipping = ship,
      tax = tax,
      discount = disc,
      grand_total = grand
    };
  }

  ~orderNotes<object>(cust<string>, internal<string>, gift<string>) {
    return {
      customer_notes = cust,
      internal_notes = internal,
      gift_message = gift
    };
  }

  ~orderMetadata<object>(ip<string>, ua<string>, referrer<string>, source<string>, device<string>) {
    return {
      ip_address = ip,
      user_agent = ua,
      referrer = referrer,
      marketing_source = source,
      device_type = device
    };
  }
)@DATA(
  store_name = "TechMart Global",
  store_id = "TM-2025-GLOBAL",
  version = "3.2.1",
  established = 2020-03-15T00:00:00Z,
  timezone = "UTC",
  default_currency = "USD",
  default_language = "en"
  
  store.configuration.general:
    store_name = "TechMart Global",
    store_id = "TM-2025-GLOBAL",
    version = "3.2.1",
    established = 2020-03-15T00:00:00Z,
    timezone = "UTC",
    default_currency = "USD",
    supported_currencies = ["USD", "EUR", "GBP", "JPY", "AUD"],
    default_language = "en",
    supported_languages = ["en", "es", "fr", "de", "ja"],
    contact = {
      support_email = "support@techmart.global",
      sales_email = "sales@techmart.global",
      phone = phones("+1-800-TECHMART", "+1-800-TECH-SUP", "+44-20-7123-4567"),
      address = address("123 Innovation Boulevard", "Suite 500", "San Francisco", "CA", "94105", "United States", coords(37.7749, -122.4194))
    }
  
  store.configuration.business_hours:
    timezone = "America/Los_Angeles",
    support_hours = {
      monday = bizHours("08:00", "20:00", lunchBreak("12:00", "13:00")),
      tuesday = bizHours("08:00", "20:00", lunchBreak("12:00", "13:00")),
      wednesday = bizHours("08:00", "20:00", lunchBreak("12:00", "13:00")),
      thursday = bizHours("08:00", "20:00", lunchBreak("12:00", "13:00")),
      friday = bizHours("08:00", "20:00", lunchBreak("12:00", "13:00")),
      saturday = bizHours("10:00", "18:00", null),
      sunday = bizHours("10:00", "18:00", null)
    }
  
  store.configuration.payment_methods:
    credit_cards = paymentConfig(true, ["visa", "mastercard", "amex", "discover"], 2.9, 0.30, 1.00, 50000.00, refundPolicy(30, 60, 15)),
    paypal = paymentConfig(true, [], 2.9, 0.30, 1.00, 50000.00, refundPolicy(30, 60, 15)),
    apple_pay = paymentConfig(true, [], 2.9, 0.30, 1.00, 50000.00, refundPolicy(30, 60, 15)),
    google_pay = paymentConfig(true, [], 2.9, 0.30, 1.00, 50000.00, refundPolicy(30, 60, 15)),
    cryptocurrency = cryptoPayment(true, ["BTC", "ETH", "USDC"], 1.5, 10.00, 100000.00, refundPolicy(14, 30, 20))
  
  store.configuration.shipping.domestic:
