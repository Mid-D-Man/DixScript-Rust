    enable_wishlists = true,
    enable_loyalty_program = true,
    enable_live_chat = true,
    enable_product_recommendations = true,
    enable_virtual_assistant = false,
    enable_ar_product_preview = false
  
  site_settings.api_configuration:
    rate_limiting = { enabled = true, requests_per_minute = 100, burst_limit = 150 },
    webhook_endpoints = {
      order_created = "https://webhooks.techmart.com/orders/created",
      order_shipped = "https://webhooks.techmart.com/orders/shipped",
      order_delivered = "https://webhooks.techmart.com/orders/delivered",
      payment_completed = "https://webhooks.techmart.com/payments/completed",
      customer_registered = "https://webhooks.techmart.com/customers/registered"
    }
  
  site_settings.seo_configuration:
    default_meta = seoMeta("TechMart Global - Premium Electronics & Tech Gear", "Shop the latest electronics, gaming laptops, monitors, and accessories at TechMart Global. Free shipping on orders over $50.", ["electronics", "gaming", "laptops", "monitors", "tech", "accessories"]),
    social_media = {
      facebook = "https://facebook.com/techmartglobal",
