  support_tickets.ticket_001:
    ticket_id = "TKT-2025-00001",
    customer_id = "CUST-001-2024",
    order_id = "ORD-2025-00001",
    subject = "Question about warranty coverage",
    category = "warranty",
    priority = "medium",
    status = "resolved",
    created_at = 2025-01-07T09:30:00Z,
    updated_at = 2025-01-07T14:45:00Z,
    resolved_at = 2025-01-07T14:45:00Z,
    assigned_to = "AGENT-003",
    messages = [
      {
        message_id = "MSG-001",
        sender_type = "customer",
        sender_id = "CUST-001-2024",
        message = "Hi, I purchased the extended warranty. Does it cover accidental damage from drops?",
        timestamp = 2025-01-07T09:30:00Z,
        attachments = []
      },
      {
        message_id = "MSG-002",
        sender_type = "agent",
        sender_id = "AGENT-003",
        message = "Hello John! Yes, the 36-month extended warranty you purchased includes coverage for accidental damage, including drops. There is a $149 deductible per incident. Is there anything else I can help you with?",
        timestamp = 2025-01-07T10:15:00Z,
        attachments = []
      },
      {
        message_id = "MSG-003",
        sender_type = "customer",
        sender_id = "CUST-001-2024",
        message = "Perfect, that's exactly what I needed to know. Thank you!",
        timestamp = 2025-01-07T14:45:00Z,
        attachments = []
      }
    ],
    resolution = {
      resolution_type = "information_provided",
      resolution_notes = "Customer inquiry about warranty coverage - confirmed accidental damage coverage",
      customer_satisfied = true,
      satisfaction_rating = 5
    }
  
