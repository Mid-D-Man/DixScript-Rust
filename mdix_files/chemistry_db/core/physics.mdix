@CONFIG(
  version -> "1.0.0",
  author -> "Chemistry System - Physics Calculations",
  created -> 2025-01-09T00:00:00Z,
  encoding -> "UTF-8",
  features -> "advanced"
)

@QUICKFUNCS(
  ~kelvinToCelsius<float>(kelvin<float>) {
    return kelvin - 273.15
  }

  ~celsiusToKelvin<float>(celsius<float>) {
    return celsius + 273.15
  }

  ~eVToKJPerMol<float>(ev<float>) {
    return ev * 96.4853
  }

  ~angstromToMeter<float>(angstrom<float>) {
    return angstrom * 1.0e-10
  }

  ~picometersToAngstrom<float>(pm<float>) {
    return pm / 100.0
  }

  ~calculateBondStrength<float>(electronegativity_diff<float>, bond_length_angstrom<float>) {
   let ionic_char = 1.0 - Math.exp(-0.25 * electronegativity_diff * electronegativity_diff)
   let  strength = (1.0 / (bond_length_angstrom * bond_length_angstrom)) * (1.0 + ionic_char)
    
    return strength
  }

  ~calculateReactivityIndex<float>(ionization_energy<float>, electron_affinity<float>, electronegativity<float>) {
  let  chemical_hardness = (ionization_energy - electron_affinity) / 2.0
  let  reactivity = electronegativity / chemical_hardness
    
    return reactivity
  }

  ~calculateDiffusionCoeff<float>(temperature_k<float>, viscosity<float>, radius_angstrom<float>) {
   let boltzmann = 1.380649e-23
   let radius_m = radius_angstrom * 1.0e-10
   let pi = 3.14159265359
    
   let diffusion = (boltzmann * temperature_k) / (6.0 * pi * viscosity * radius_m)
    
    return diffusion
  }

  ~simulateLJForce<float>(distance_angstrom<float>, epsilon_k<float>, sigma_angstrom<float>) {
   let r = distance_angstrom
   let sig = sigma_angstrom
  let  eps = epsilon_k
    
  let  sigma_over_r_6 = Math.pow(sig / r, 6.0)
   let sigma_over_r_12 = sigma_over_r_6 * sigma_over_r_6
    
  let  potential = 4.0 * eps * (sigma_over_r_12 - sigma_over_r_6)
    
    return potential
  }

  ~calculateVanDerWaalsForce<float>(polarizability1<float>, polarizability2<float>, distance_angstrom<float>) {
   let r = distance_angstrom * 1.0e-10
   let alpha1 = polarizability1 * 1.0e-30
  let  alpha2 = polarizability2 * 1.0e-30
    
  let  c6 = (3.0 / 4.0) * alpha1 * alpha2
  let  force = -6.0 * c6 / Math.pow(r, 7.0)
    
    return force
  }

  ~calculateIonizationEnergy<float>(atomic_number<int>, electron_removed<int>) {
  let  z_effective = atomic_number - (electron_removed - 1.0) * 0.35
  let  n_principal = Math.sqrt(electron_removed)
    
  let  ionization_ev = 13.6 * (z_effective * z_effective) / (n_principal * n_principal)
    
    return ionization_ev
  }

  ~calculateOrbitalRadius<float>(principal_quantum_number<int>, atomic_number<int>) {
  let  bohr_radius_angstrom = 0.529177
  let  n = principal_quantum_number
  let  z = atomic_number
    
  let  radius = bohr_radius_angstrom * (n * n) / z
    
    return radius
  }
)
