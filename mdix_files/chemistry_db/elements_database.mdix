    core = builders.createIdentity("Technetium", "Tc", 43, 98.0, enums.ElementGroup.TRANSITION_METAL, 5, enums.Block.D_BLOCK, enums.ElementGroup.TRANSITION_METAL, enums.Phase.SOLID),
