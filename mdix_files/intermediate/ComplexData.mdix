@CONFIG(
    version -> "1.0.0",
    encoding -> "UTF-8",
    author -> "DixScript_Complex_Data_Test",
    features -> "intermediate",
    created -> "2024-01-15T16:45:00Z",
    debug_mode -> "regular",
    error_handling -> "recover",
    compatibility_mode -> "best_effort"
)

//ok no func calls within functions or maybe we should just make it so
//but then we have to deal with so many extra stuff, ok i need some advice
//yeah gonna have to learn how to prevent recursive calls and while we at it probably add
//foreach statements
//and increase param limit to 16 or 12
