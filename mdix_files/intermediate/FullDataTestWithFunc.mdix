@CONFIG(
    version -> "1.0.0",
    encoding -> "UTF-8",
    author -> "DixScript_Complete_QuickFuncs_Data_Test",
    features -> "advanced",
    created -> "2025-10-21T14:30:00Z",
    debug_mode -> "verbose",
    error_handling -> "halt"
)





@DLM(
    DCompressor.gzip,
    DAuditor.enhanced
)





@ENUMS(
    UserRole { GUEST = 0, USER = 1, MODERATOR = 5, ADMIN = 10, SUPER_ADMIN = 15 }
    Difficulty { EASY = 1, NORMAL = 2, HARD = 3, EXTREME = 5, NIGHTMARE = 10 }
    HttpStatus { OK = 200, CREATED = 201, BAD_REQUEST = 400, NOT_FOUND = 404, SERVER_ERROR = 500 }
    TokenType { ERC20, ERC721, ERC1155 }
    LogLevel { DEBUG = 0, INFO = 1, WARN = 2, ERROR = 3, FATAL = 4 }
    GameState { MENU, LOADING, PLAYING, PAUSED, GAME_OVER }
    ItemRarity { COMMON = 1, UNCOMMON = 2, RARE = 3, EPIC = 4, LEGENDARY = 5 }
)

@QUICKFUNCS(
    // ============================================================
    // BASIC ARITHMETIC WITH BUILT-INS
    // ============================================================
    
    ~calculateDamage<int> => global(base<int>, difficulty<enum>) {
       let multiplier = difficulty == Difficulty.EASY ? 0.5 :
                     difficulty == Difficulty.NORMAL ? 1.0 :
                     difficulty == Difficulty.HARD ? 1.5 :
                     difficulty == Difficulty.EXTREME ? 2.0 : 3.0;
       let damage = base * multiplier;
        return Math.round(damage);
    }
    
    ~applyTaxAndDiscount<float> => global(price<float>, tax_rate<float>, discount<float>) {
      let  taxed = price + (price * tax_rate);
      let  final = taxed - (taxed * discount);
        return Math.round(final * 100.0) / 100.0;
    }
    
    ~calculateCompoundInterest<float> => global(principal<float>, rate<float>, years<int>) {
       let result = principal * Math.pow(1.0 + rate, years);
        return Math.round(result * 100.0) / 100.0;
    }
    
    ~clampHealth<int> => global(current<int>, min<int>, max<int>) {
        return Math.clamp(current, min, max);
    }
    
    ~calculateDistance<float> => global(x1<float>, y1<float>, x2<float>, y2<float>) {
      let  dx = x2 - x1;
      let  dy = y2 - y1;
      let  distance_sq = (dx * dx) + (dy * dy);
        return Math.sqrt(distance_sq);
    }
    
    // ============================================================
    // STRING OPERATIONS WITH COMPLEX CHAINING
    // ============================================================
    
    ~formatUserDisplayName<string> => global(first<string>, last<string>, id<int>) {
     let   full_name = first.trim().toUpper() + " " + last.trim().toUpper();
     let   display = full_name + " #" + id.toString();
        return display;
    }
    
    ~sanitizeAndFormat<string> => global(input<string>) {
      let  cleaned = input.trim().toLower().replace("  ", " ");
        return cleaned;
    }
    
    ~validateEmail<bool> => global(email<string>) {
      let  trimmed = email.trim().toLower();
      let  has_at = trimmed.contains("@");
      let  has_dot = trimmed.contains(".");
      let  has_length = trimmed.length() > 5;
        return has_at && has_dot && has_length;
    }
    
~extractDomain<string> => global(email<string>) {
 let   cleaned = email.trim().toLower();
  let  at_pos = cleaned.indexOf("@");
    
    if: at_pos >= 0 {  // FIXED: Changed from > 0 to >= 0
   let     domain_start = at_pos + 1;
    let    domain_length = cleaned.length() - domain_start;
    let    domain = cleaned.substring(domain_start, domain_length);
        return domain;
    }
    
    return "invalid";
}
    ~formatPhoneNumber<string> => global(digits<string>) {
      let  cleaned = digits.replace("-", "").replace(" ", "").replace("(", "").replace(")", "");
        if: cleaned.length() == 10 {
      let      area = cleaned.substring(0, 3);
      let      prefix = cleaned.substring(3, 3);
       let     line = cleaned.substring(6, 4);
            return "(" + area + ") " + prefix + "-" + line;
        }
        return cleaned;
    }
    
    ~superComplexStringChain<string> => global(input<string>) {
     let   step1 = input.trim().toLower().replace("_", "-");
     let   step2 = step1.replace("  ", " ").substring(0, 100);
     let   step3 = step2.toUpper().replace("-", " ").trim();
     let   step4 = step3.padLeft(120, " ").padRight(150, " ");
     let   final = step4.trim().substring(0, 50);
        return final;
    }
    
    // ============================================================
    // ARRAY OPERATIONS WITH COMPLEX CHAINING
    // ============================================================
    
    ~calculateTopThreeAverage<float> => global(scores<array>) {
     let   sorted = scores.sort();
     let   reversed = sorted.reverse();
     let   top_three = reversed.slice(0, 3);
     let   total = top_three.sum();
     let   avg = total / 3.0;
        return Math.round(avg * 100.0) / 100.0;
    }
    
    ~processScores<array> => global(raw_scores<array>) {
    let    filtered = raw_scores.filter(0);
    let    unique = filtered.distinct();
    let    sorted = unique.sort();
        return sorted;
    }
    
    ~getTopNScores<int> => global(scores<array>, n<int>) {
    let    sorted = scores.sort().reverse();
    let    top_n = sorted.slice(0, n);
    let    total = top_n.sum();
        return Math.round(total);
    }
    
    ~analyzeArrayStats<tuple> => global(numbers<array>) {
    let    min_val = numbers.min();
    let    max_val = numbers.max();
    let    avg_val = numbers.average();
    let    total = numbers.sum();
        return t:(Math.round(min_val), Math.round(max_val), Math.round(avg_val), Math.round(total));
    }
    
    ~concatenateAndSort<array> => global(arr1<array>, arr2<array>) {
    let    combined = arr1.concat(arr2);
    let    unique = combined.distinct();
    let    sorted = unique.sort();
        return sorted;
    }
    
    ~wildArrayChaining<array> => global(input<array>) {
    let    step1 = input.distinct().sort().reverse();
    let    step2 = step1.slice(0, 10).concat(step1.slice(10, 5));
    let    step3 = step2.distinct().sort();
    let    final = step3.reverse().slice(0, 8);
        return final;
    }
    
    // ============================================================
    // DATETIME OPERATIONS
    // ============================================================
    
    ~calculateDaysUntil<int> => global(target_date<date>) {
    let    today = DateTime.today();
    let    days_diff = DateTime.subtract(target_date, today);
        return Math.round(days_diff);
    }
    
    ~formatTimestamp<string> => global(ts<timestamp>) {
    let    formatted = DateTime.format(ts, "yyyy-MM-dd HH:mm:ss");
        return formatted;
    }
    
    ~addBusinessDays<timestamp> => global(start_date<date>, days<int>) {
    let    result = DateTime.addDays(start_date, days);
        return result;
    }
    
    ~isWeekend<bool> => global(check_date<date>) {
    let    day_of_week = DateTime.dayOfWeek(check_date);
        return day_of_week == 0 || day_of_week == 6;
    }
    
    ~calculateAge<int> => global(birth_date<date>) {
     let   today = DateTime.today();
     let   years = DateTime.subtract(today, birth_date) / 365.25;
        return Math.floor(years);
    }
    
    // ============================================================
    // RANDOM NUMBER GENERATION
    // ============================================================
    
    ~rollDice<int> => global(sides<int>) {
        return Random.range(1, sides);
    }
    
    ~rollMultipleDice<int> => global(num_dice<int>, sides<int>) {
     let mut   total = 0;
     let   counter = 0;
        if: num_dice > 0 {
            total = Random.range(num_dice, num_dice * sides);
        }
        return total;
    }
    
    ~generateRandomId<string> => global(length<int>) {
        return Random.alphanumeric(length);
    }
    
    ~selectRandomItem<string> => global(items<array>) {
        return Random.choice(items);
    }
    
    // ============================================================
    // ENUM OPERATIONS
    // ============================================================
    
    ~checkPermission<bool> => global(user_role<enum>, required_role<enum>) {
        return user_role >= required_role;
    }
    
    ~getNextDifficulty<enum> => global(current<enum>) {
        if: current == Difficulty.EASY {
            return Difficulty.NORMAL;
        }
        if: current == Difficulty.NORMAL {
            return Difficulty.HARD;
        }
        if: current == Difficulty.HARD {
            return Difficulty.EXTREME;
        }
        return Difficulty.NIGHTMARE;
    }
    
    ~roleToString<string> => global(role<enum>) {
        return role == UserRole.GUEST ? "Guest User" :
               role == UserRole.USER ? "Standard User" :
               role == UserRole.MODERATOR ? "Moderator" :
               role == UserRole.ADMIN ? "Administrator" : "Super Administrator";
    }
    
    // ============================================================
    // NESTED IF-ELIF-ELSE STATEMENTS
    // ============================================================
    
    ~classifyScore<string> => global(score<int>, difficulty<enum>) {
     let mut   result = "";
        
        if: difficulty == Difficulty.EASY {
            if: score >= 90 {
                result = "Perfect Easy";
            }
            elif: score >= 70 {
                result = "Good Easy";
            }
            elif: score >= 50 {
                result = "Pass Easy";
            }
            else {
                result = "Fail Easy";
            }
        }
        elif: difficulty == Difficulty.NORMAL {
            if: score >= 85 {
                result = "Excellent Normal";
            }
            elif: score >= 65 {
                result = "Good Normal";
            }
            elif: score >= 45 {
                result = "Pass Normal";
            }
            else {
                result = "Fail Normal";
            }
        }
        elif: difficulty == Difficulty.HARD {
            if: score >= 80 {
                result = "Amazing Hard";
            }
            elif: score >= 60 {
                result = "Great Hard";
            }
            elif: score >= 40 {
                result = "Pass Hard";
            }
            else {
                result = "Fail Hard";
            }
        }
        else {
            if: score >= 70 {
                result = "Legendary";
            }
            elif: score >= 50 {
                result = "Epic";
            }
            elif: score >= 30 {
                result = "Rare";
            }
            else {
                result = "Common";
            }
        }
        
        return result;
    }
    
    ~complexNestedLogic<int> => global(a<int>, b<int>, c<int>) {
     let mut   result = 0;
        
        if: a > 50 {
            if: b > 50 {
                if: c > 50 {
                    result = a + b + c;
                }
                elif: c > 25 {
                    result = a + b;
                }
                else {
                    result = a;
                }
            }
            elif: b > 25 {
                if: c > 50 {
                    result = a + c;
                }
                else {
                    result = a - b;
                }
            }
            else {
                result = a * 2;
            }
        }
        elif: a > 25 {
            if: b > 50 {
                result = b + c;
            }
            elif: b > 25 {
                result = (a + b) / 2;
            }
            else {
                result = c;
            }
        }
        else {
            if: b > 50 {
                result = b * 2;
            }
            elif: c > 50 {
                result = c * 2;
            }
            else {
                result = (a + b + c) / 3;
            }
        }
        
        return Math.round(result);
    }
    
    ~categorizePlayer<string> => global(level<int>, score<int>, playtime<int>) {
     let mut   category = "";
        
        if: level >= 50 {
            if: score >= 10000 {
                if: playtime >= 1000 {
                    category = "Elite Veteran";
                }
                elif: playtime >= 500 {
                    category = "Elite Regular";
                }
                else {
                    category = "Elite Casual";
                }
            }
            elif: score >= 5000 {
                if: playtime >= 800 {
                    category = "Pro Veteran";
                }
                else {
                    category = "Pro Player";
                }
            }
            else {
                category = "High Level";
            }
        }
        elif: level >= 25 {
            if: score >= 5000 {
                category = "Advanced High Scorer";
            }
            elif: score >= 2500 {
                category = "Advanced Player";
            }
            else {
                category = "Mid Level";
            }
        }
        elif: level >= 10 {
            if: score >= 1000 {
                category = "Intermediate Achiever";
            }
            else {
                category = "Intermediate";
            }
        }
        else {
            if: playtime >= 100 {
                category = "Dedicated Beginner";
            }
            elif: playtime >= 50 {
                category = "Active Beginner";
            }
            else {
                category = "New Player";
            }
        }
        
        return category;
    }
    
    // ============================================================
    // CONDITIONAL LOGIC WITH SWITCH
    // ============================================================
    
    ~calculateBonus<int> => global(score<int>, difficulty<enum>) {
       let mut  base_bonus = 0;
        
        chk: difficulty {
            -> Difficulty.EASY {
                base_bonus = score * 1;
            }
            -> Difficulty.NORMAL {
                base_bonus = score * 2;
            }
            -> Difficulty.HARD {
                base_bonus = score * 3;
            }
            -> Difficulty.EXTREME {
                base_bonus = score * 5;
            }
            -> miss {
                base_bonus = 0;
            }
        }
        
        return base_bonus;
    }
    
    ~getHttpMessage<string> => global(status<enum>) {
        chk: status {
            -> HttpStatus.OK {
                return "Success";
            }
            -> HttpStatus.CREATED {
                return "Resource Created";
            }
            -> HttpStatus.BAD_REQUEST {
                return "Invalid Request";
            }
            -> HttpStatus.NOT_FOUND {
                return "Resource Not Found";
            }
            -> miss {
                return "Unknown Status";
            }
        }
    }
    
    ~processGameState<string> => global(state<enum>, score<int>) {
     let mut   message = "";
        
        chk: state {
            -> GameState.MENU {
                message = "Welcome to the game!";
            }
            -> GameState.LOADING {
                message = "Loading assets...";
            }
            -> GameState.PLAYING {
                if: score > 1000 {
                    message = "Doing great! Score: " + score;
                }
                elif: score > 500 {
                    message = "Good progress! Score: " + score;
                }
                else {
                    message = "Keep going! Score: " + score;
                }
            }
            -> GameState.PAUSED {
                message = "Game paused. Current score: " + score;
            }
            -> GameState.GAME_OVER {
                if: score > 5000 {
                    message = "Victory! Final score: " + score;
                }
                else {
                    message = "Game Over. Final score: " + score;
                }
            }
            -> miss {
                message = "Unknown game state";
            }
        }
        
        return message;
    }
    
    ~calculateItemValue<int> => global(rarity<enum>, level<int>) {
     let mut   base_value = 0;
        
        chk: rarity {
            -> ItemRarity.COMMON {
                base_value = 10;
            }
            -> ItemRarity.UNCOMMON {
                base_value = 50;
            }
            -> ItemRarity.RARE {
                base_value = 200;
            }
            -> ItemRarity.EPIC {
                base_value = 1000;
            }
            -> ItemRarity.LEGENDARY {
                base_value = 5000;
            }
            -> miss {
                base_value = 1;
            }
        }
        
      let  multiplier = 1.0 + (level * 0.1);
      let  final_value = base_value * multiplier;
        
        return Math.round(final_value);
    }
    
// ============================================================
// DYNAMIC OBJECT CREATION (FIXED)
// ============================================================

~createPlayerProfile<object> => global(name<string>, level<int>, score<int>) {
    // FIXED: Evaluate expressions into variables first
  let  display_name_value = name.trim().toUpper();
    
  let  rank = level >= 50 ? "Master" :
           level >= 30 ? "Expert" :
           level >= 15 ? "Advanced" : "Beginner";
    
  let  status = score >= 10000 ? "Elite" :
             score >= 5000 ? "Pro" :
             score >= 1000 ? "Skilled" : "Learning";
    
  let  power_rating_calc = (level * 10) + (score / 100);
  let  power_rating_value = Math.round(power_rating_calc);
    
  let  is_veteran_calc = level >= 30 && score >= 5000;
    
  let  profile = {
        display_name = display_name_value,
        player_level = level,
        total_score = score,
        rank_title = rank,
        status_badge = status,
        power_rating = power_rating_value,
        is_veteran = is_veteran_calc
    };
    
    return profile;
}

~createInventoryItem<object> => global(name<string>, rarity<enum>, quantity<int>, base_price<float>) {
  let  rarity_multiplier = rarity == ItemRarity.COMMON ? 1.0 :
                       rarity == ItemRarity.UNCOMMON ? 2.5 :
                       rarity == ItemRarity.RARE ? 5.0 :
                       rarity == ItemRarity.EPIC ? 10.0 : 25.0;
    
   let final_price = base_price * rarity_multiplier;
  let  total_value = final_price * quantity;
    
  let  rarity_text = rarity == ItemRarity.COMMON ? "Common" :
                  rarity == ItemRarity.UNCOMMON ? "Uncommon" :
                  rarity == ItemRarity.RARE ? "Rare" :
                  rarity == ItemRarity.EPIC ? "Epic" : "Legendary";
    
    // FIXED: Calculate values before object creation
 let   unit_price_rounded = Math.round(final_price * 100.0) / 100.0;
 let   total_worth_rounded = Math.round(total_value * 100.0) / 100.0;
 let   is_valuable_calc = total_value > 1000.0;
 let   stack_size_calc = quantity > 99 ? 99 : quantity;
    
 let   item = {
        item_name = name,
        rarity_level = rarity,
        rarity_display = rarity_text,
        qty = quantity,
        unit_price = unit_price_rounded,
        total_worth = total_worth_rounded,
        is_valuable = is_valuable_calc,
        stack_size = stack_size_calc
    };
    
    return item;
}

~buildOrderDetails<object> => global(order_id<int>, subtotal<float>, tax_rate<float>, discount<float>) {
 let   tax_amount = subtotal * tax_rate;
 let   discount_amount = subtotal * discount;
 let   total_before_tax = subtotal - discount_amount;
 let   final_total = total_before_tax + (total_before_tax * tax_rate);
    
 let   status = final_total > 1000.0 ? "Premium" :
             final_total > 500.0 ? "Standard" : "Economy";
    
  let  shipping = final_total > 100.0 ? 0.0 :
               final_total > 50.0 ? 5.0 : 10.0;
    
  let  grand_total = final_total + shipping;
    
    // FIXED: Calculate all values before object creation
  let  subtotal_rounded = Math.round(subtotal * 100.0) / 100.0;
  let  tax_rounded = Math.round(tax_amount * 100.0) / 100.0;
   let discount_rounded = Math.round(discount_amount * 100.0) / 100.0;
   let total_rounded = Math.round(grand_total * 100.0) / 100.0;
  let  free_shipping_calc = shipping == 0.0;
  let  is_bulk_calc = subtotal > 500.0;
    
  let  order = {
        id = order_id,
        order_subtotal = subtotal_rounded,
        tax = tax_rounded,
        discount = discount_rounded,
        shipping_cost = shipping,
        total = total_rounded,
        order_status = status,
        free_shipping = free_shipping_calc,
        is_bulk_order = is_bulk_calc
    };
    
    return order;
}

~createCharacterStats<object> => global(name<string>, class<string>, level<int>) {
 let   base_health = 100;
 let   base_mana = 50;
  let  base_damage = 10;
    
  let  health_bonus = level * 15;
  let  mana_bonus = level * 10;
  let  damage_bonus = level * 2;
    
  let  class_health_mult = class == "warrior" ? 1.5 :
                       class == "mage" ? 0.8 :
                       class == "rogue" ? 1.0 : 1.2;
    
  let  class_mana_mult = class == "mage" ? 2.0 :
                     class == "warrior" ? 0.5 :
                     class == "rogue" ? 1.0 : 1.5;
    
  let  class_damage_mult = class == "rogue" ? 1.5 :
                       class == "warrior" ? 1.3 :
                       class == "mage" ? 1.0 : 1.1;
    
  let  final_health = Math.round((base_health + health_bonus) * class_health_mult);
  let  final_mana = Math.round((base_mana + mana_bonus) * class_mana_mult);
  let  final_damage = Math.round((base_damage + damage_bonus) * class_damage_mult);
    
    // FIXED: Calculate all values before object creation
 let   character_name_value = name.trim().toUpper();
  let  defense_calc = Math.round(level * 1.5);
  let  speed_calc = Math.round(level * 0.8);
  let  critical_calc = Math.min(level * 0.5, 50.0);
  let  power_level_calc = Math.round((final_health + final_mana + final_damage) / 3);
    
 let   stats = {
        character_name = character_name_value,
        character_class = class,
        character_level = level,
        max_health = final_health,
        max_mana = final_mana,
        attack_damage = final_damage,
        defense = defense_calc,
        speed = speed_calc,
        critical_chance = critical_calc,
        power_level = power_level_calc
    };
    
    return stats;
}

~generateLootTable<object> => global(enemy_level<int>, difficulty<enum>, luck<double>) {
  let  base_gold = enemy_level * 10;
  let  base_exp = enemy_level * 25;
    
  let  diff_mult = difficulty == Difficulty.EASY ? 0.5 :
               difficulty == Difficulty.NORMAL ? 1.0 :
               difficulty == Difficulty.HARD ? 1.5 :
               difficulty == Difficulty.EXTREME ? 2.5 : 4.0;
    
  let  luck_mult = 1.0 + luck;
    
 let   final_gold = Math.round(base_gold * diff_mult * luck_mult);
 let   final_exp = Math.round(base_exp * diff_mult);
    
  let  drop_chance = Math.min(50.0 + (luck * 100.0), 95.0);
  let  rare_chance = Math.min(10.0 + (luck * 50.0), 50.0);
  let  has_bonus_calc = luck > 0.5;
 let   guaranteed_drop_calc = drop_chance >= 95.0;
let drop_chance_rounded = Math.round(drop_chance * 100.0) / 100.0;



  let  rare_chance_rounded = Math.round(rare_chance * 100.0) / 100.0;
    
  let  loot = {
        gold_amount = final_gold,
        experience = final_exp,
        item_drop_chance = drop_chance_rounded,
        rare_drop_chance = rare_chance_rounded,
        enemy_difficulty = difficulty,
        has_bonus_loot = has_bonus_calc,
        guaranteed_drop = guaranteed_drop_calc
    };
    
    return loot;
}
    
    // ============================================================
    // COMPLEX NESTED LOGIC (MAX 3 LEVELS)
    // ============================================================
    
    ~calculateFinalScore<int> => global(base<int>, multiplier<float>, bonus<int>) {
    let    adjusted = Math.round(base * multiplier);
    let    total = adjusted + bonus;
     let   clamped = Math.clamp(total, 0, 1000);
        return clamped;
    }
    
    ~processUserData<tuple> => global(first<string>, last<string>, score<int>) {
     let   full_name = first.trim().toUpper() + " " + last.trim().toUpper();
     let   adjusted_score = Math.clamp(score, 0, 100);
      let  grade = adjusted_score >= 90 ? "A" :
                adjusted_score >= 80 ? "B" :
                adjusted_score >= 70 ? "C" :
                adjusted_score >= 60 ? "D" : "F";
        return t:(full_name, adjusted_score, grade);
    }
    
    ~complexCalculationChain<int> => global(a<int>, b<int>, c<int>, d<int>) {
     let   step1 = Math.max(a, b);
       let step2 = Math.min(c, d);
      let  step3 = Math.abs(step1 - step2);
       let step4 = Math.pow(step3, 2);
       let step5 = Math.sqrt(step4 + 100);
       let result = Math.round(step5 * 1.5);
        return result;
    }
    
    // ============================================================
    // SCOPED FUNCTIONS FOR TABLE/GROUP TESTING
    // ============================================================
    
    ~calculateOrderTotal<float> => orders(subtotal<float>, tax_rate<float>, shipping<float>) {
      let  tax = subtotal * tax_rate;
      let  total = subtotal + tax + shipping;
        return Math.round(total * 100.0) / 100.0;
        
       
    }
    
    ~validateOrderAmount<bool> => orders(subtotal<float>, min<float>, max<float>) {
        return subtotal >= min && subtotal <= max;
    }
    
    ~formatProductDisplay<string> => products(name<string>, price<float>, stock<int>) {
      let  formatted_price = Math.round(price * 100.0) / 100.0;
        // FIXED: Inline the role-to-string logic instead of calling roleToString()
      let  display = name.toUpper() + " - $" + formatted_price.toString() + " (" + stock.toString() + " in stock)";
        return display;
    }
    
    ~calculateProductPrice<float> => products(base<float>, markup<float>, tax<float>) {
      let  retail = base * markup;
       let final = retail + tax;
        return Math.round(final * 100.0) / 100.0;
    }
    
    ~formatUserProfile<string> => users(first<string>, last<string>, role<enum>) {
      let  full = first.trim() + " " + last.trim();
        // FIXED: Inline the enum-to-string conversion instead of calling roleToString()
      let  role_str = role == UserRole.GUEST ? "Guest User" :
                   role == UserRole.USER ? "Standard User" :
                   role == UserRole.MODERATOR ? "Moderator" :
                   role == UserRole.ADMIN ? "Administrator" : "Super Administrator";
        return full + " - " + role_str;
    }
    
    ~calculateUserScore<int> => users(base_score<int>, bonus<int>, level<int>) {
       let total = base_score + bonus + (level * 10);
        return Math.clamp(total, 0, 9999);
    }
    
    // ============================================================
    // COMPLEX CHAINING EXAMPLES
    // ============================================================
    
    ~chainedStringOperations<string> => global(input<string>) {
      let  result = input.trim()
                     .toLower()
                     .replace("  ", " ")
                     .replace("_", "-")
                     .substring(0, 50);
        return result;
    }
    
    ~chainedArrayOperations<int> => global(numbers<array>) {
       let result = numbers.distinct()
                       .sort()
                       .reverse()
                       .slice(0, 5)
                       .sum();
        return Math.round(result);
    }
    
    ~chainedNumericOperations<float> => global(value<float>) {
      let  result = value.abs()
                     .round(2)
                     .toDouble();
      let  final = Math.sqrt(result);
        return Math.round(final * 100.0) / 100.0;
    }
    
    ~insaneArrayChaining<array> => global(input<array>) {
      let  step1 = input.sort().reverse().distinct();
      let  step2 = step1.slice(0, 10).concat(input.slice(5, 5));
      let  step3 = step2.distinct().sort().reverse();
      let  step4 = step3.slice(0, 15);
      let  final = step4.sort();
        return final;
    }
    
    ~crazyStringChaining<string> => global(text<string>) {
      let  step1 = text.trim().toLower();
      let  step2 = step1.replace(" ", "_").replace("-", "_");
      let  step3 = step2.toUpper().substring(0, 100);
      let  step4 = step3.padLeft(120, "X").padRight(150, "Y");
      let  step5 = step4.trim().replace("X", "").replace("Y", "");
       let final = step5.substring(0, 50).trim();
        return final;
    }
    
    // ============================================================
    // EXPRESSION COMPLEXITY EXAMPLES
    // ============================================================
    
    ~complexArithmetic<int> => global(a<int>, b<int>, c<int>, d<int>) {
       let result = ((a + b) * (c - d)) + (a * b) - (c / 2);
        return Math.round(result);
    }
    
    ~complexConditional<string> => global(score<int>, level<int>, bonus<int>) {
      let  grade = score >= 90 && level > 5 ? "S-Rank" :
                score >= 80 && level > 3 ? "A-Rank" :
                score >= 70 && bonus > 100 ? "B-Rank" :
                score >= 60 ? "C-Rank" : "D-Rank";
        return grade;
    }
    
    ~complexLogical<bool> => global(x<int>, y<int>, z<int>) {
      let  condition1 = x > 10 && y < 20;
      let  condition2 = z >= 5 || x == 0;
       let condition3 = (x + y) > z;
        return (condition1 || condition2) && condition3;
    }
    
    ~megaComplexExpression<int> => global(a<int>, b<int>, c<int>, d<int>, e<int>) {
      let  part1 = (a + b) * c;
      let  part2 = (d - e) / 2;
      let  part3 = Math.pow(a, 2) + Math.pow(b, 2);
       let part4 = Math.sqrt(part3);
       let part5 = Math.abs(part1 - part2);
       let result = Math.round((part4 + part5) * 1.5);
        return Math.clamp(result, 0, 10000);
    }
    
    // ============================================================
    // TERNARY NESTING (MAX 3 LEVELS)
    // ============================================================
    
    ~nestedTernary<string> => global(value<int>) {
      let  result = value > 100 ? "high" :
                 value > 50 ? (value > 75 ? "medium-high" : "medium") :
                 value > 25 ? "low-medium" : "low";
        return result;
    }
    
    ~deepNestedTernary<string> => global(score<int>, level<int>) {
      let  result = score > 90 ? (level > 10 ? "Elite Master" : "Elite") :
                 score > 70 ? (level > 10 ? (score > 80 ? "Pro Master" : "Pro Advanced") : "Pro") :
                 score > 50 ? (level > 5 ? "Advanced" : "Intermediate") : "Beginner";
        return result;
    }
    
    ~tripleNestedTernary<int> => global(a<int>, b<int>, c<int>) {
      let  result = a > b ? (b > c ? a : (a > c ? a : c)) :
                 b > c ? (a > c ? b : (b > a ? b : a)) : c;
        return result;
    }
    
    // ============================================================
    // WORKING WITH TUPLES
    // ============================================================
    
    ~createCoordinates<tuple> => global(lat<float>, lon<float>, alt<float>) {
        return t:(
            Math.round(lat * 1000000.0) / 1000000.0,
            Math.round(lon * 1000000.0) / 1000000.0,
            Math.round(alt * 100.0) / 100.0
        );
    }
    
    ~createUserRecord<tuple> => global(name<string>, age<int>, score<float>) {
      let  formatted_name = name.trim().toUpper();
     let   clamped_age = Math.clamp(age, 0, 150);
      let  rounded_score = Math.round(score * 100.0) / 100.0;
        return t:(formatted_name, clamped_age, rounded_score);
    }
    
    ~createGameStats<tuple> => global(kills<int>, deaths<int>, assists<int>, playtime<int>) {
      let  kda = deaths > 0 ? (kills + assists) / deaths : kills + assists;
      let  rounded_kda = Math.round(kda * 100.0) / 100.0;
      let  avg_kills_per_hour = playtime > 0 ? (kills * 60.0) / playtime : 0.0;
        return t:(kills, deaths, assists, rounded_kda);
    }
    
    // ============================================================
    // VARIABLE DECLARATION AND ASSIGNMENT PATTERNS
    // ============================================================
    
    ~testVariableScopes<int> => global(input<int>) {
      let  local1 = input * 2;
      let  local2 = local1 + 10;
      let  local3 = local2 - 5;
        let mut result = 0;
        if: local3 > 50 {
            result = local3 * 2;
            return result;
        }
        elif: local3 > 25 {
       let     temp = local3 + 15;
            result = temp * 1.5;
            return Math.round(result);
        }
        else {
         let   final = local3 - 10;
            return Math.max(final, 0);
        }
    }
    
    ~arithmeticAssignments<int> => global(base<int>) {
     let mut   counter = 0;
        counter += base;
        counter += 10;
        counter *= 2;
        counter -= 5;
        counter /= 3;
        return Math.round(counter);
    }
    
    // ============================================================
    // LOGGING AND DEBUGGING EXAMPLES
    // ============================================================
    
    ~debugCalculation<int> => global(a<int>, b<int>) {
       let sum = a + b;
        log: "Sum calculated: " + sum.toString();
        
      let  product = a * b;
        log: "Product calculated: " + product.toString();
        
        if: sum > product {
            log: "Sum is greater";
            return sum;
        }
        else {
            log: "Product is greater";
            return product;
        }
    }
)
