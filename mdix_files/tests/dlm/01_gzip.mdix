@CONFIG(
  version -> "1.0.0"
  author  -> "DLM Test — GZip Compression Only"
)

@DLM(
  DCompressor.gzip
)

@DATA(
  app_name    = "DLMTestApp"
  version     = "1.0.0"
  environment = "test"
  note        = "compressed_with_gzip"
  port<int>   = 8443
  active<bool> = true
  score<double> = 9.87654321

  server: host = "dlm.test.internal", ssl = true, timeout<int> = 30

  endpoints::
    "https://api.test/v1/health",
    "https://api.test/v1/status",
    "https://api.test/v1/metrics"
)
