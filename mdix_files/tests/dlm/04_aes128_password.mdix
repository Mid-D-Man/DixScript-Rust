@CONFIG(
  version -> "1.0.0"
  author  -> "DLM Test — AES-128 Password Encryption"
)

@DLM(
  DEncryptor.aes256
)

@DATA(
  app_name    = "DLMTestApp"
  version     = "1.0.0"
  environment = "test"
  note        = "encrypted_aes128_password_mode"
  port<int>   = 8443
  active<bool> = true
  score<double> = 9.87654321

  server: host = "dlm.test.internal", ssl = true, timeout<int> = 30

  endpoints::
    "https://api.test/v1/health",
    "https://api.test/v1/status",
    "https://api.test/v1/metrics"
)

@SECURITY(
  // mode: "keyfile"  → compiler auto-generates a .mdix.key file
  // mode: "password" → compiler prompts for a password at compile time
  encryption -> {
    mode      = "keyfile",
    algorithm = "aes256-gcm"
  }
)
