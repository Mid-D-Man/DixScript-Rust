// Test: AES-256 password mode
// Compile: mdix compile security_02_password_aes256.mdix -o ./output --password "TestPassword123!"
//    OR:   MDIX_DLM_PASSWORD="TestPassword123!" mdix compile security_02_password_aes256.mdix -o ./output
// Decrypt: mdix decrypt ./output/security_02_password_aes256.mdix.enc --password "TestPassword123!"
//    OR:   mdix decrypt ./output/security_02_password_aes256.mdix.enc --password-prompt

@CONFIG(
  version -> "1.0.0"
  author  -> "MidManStudio Security Test — Password Mode"
)

@ENUMS(
  Env    { LOCAL = 0, CI = 1, STAGING = 2, PROD = 3 }
  Region { US_EAST = 0, US_WEST = 1, EU_WEST = 2, AP_SOUTH = 3 }
)

@DLM(
  DEncryptor.aes256
)

@QUICKFUNCS(
  ~endpoint<object>(base_url, version<int>, region<enum>) {
    return {
      url        = $"{base_url}/v{version}"
      region     = region
      timeout    = 5000
      rate_limit = 1000
    }
  }

  ~oauthConfig<object>(provider, client_id, redirect_uri) {
    return {
      provider     = provider
      client_id    = client_id
      redirect_uri = redirect_uri
      scope        = "openid profile email"
    }
  }
)

@DATA(
  deployment_env<enum> = Env.PROD
  primary_region<enum> = Region.US_EAST

  app_name    = "AuthService"
  version     = "3.0.0"
  build_num   = "20250601-001"

  primary_api =  endpoint("https://api.prod.example.com", 2, Region.US_EAST)
  secondary_api = endpoint("https://api-eu.prod.example.com", 2, Region.EU_WEST)

  google_oauth =  oauthConfig("google",  "google_client_id_replace_me",  "https://app.example.com/auth/google")
  github_oauth =  oauthConfig("github",  "github_client_id_replace_me",  "https://app.example.com/auth/github")
  discord_oauth = oauthConfig("discord", "discord_client_id_replace_me", "https://app.example.com/auth/discord")

  google_client_secret  = "google_client_secret_replace_me"
  github_client_secret  = "github_client_secret_replace_me"
  discord_client_secret = "discord_client_secret_replace_me"

  jwt_private_key  = "-----BEGIN RSA PRIVATE KEY-----\nreplace_with_real_pem_key\n-----END RSA PRIVATE KEY-----"
  jwt_public_key   = "-----BEGIN PUBLIC KEY-----\nreplace_with_real_public_pem\n-----END PUBLIC KEY-----"

  encryption_master_key = "aes256_master_key_replace_with_64_hex_chars_minimum"
  signing_hmac_key      = "hmac_signing_key_replace_with_secure_random_value"
)

@SECURITY(
  encryption -> {
    mode      = "password",
    algorithm = "aes256-gcm"
  }
)
