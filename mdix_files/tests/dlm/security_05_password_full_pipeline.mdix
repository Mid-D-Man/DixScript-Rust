// Test: Full pipeline — GZip + AES-256 + Enhanced Audit, password mode
// Compile: mdix compile security_05_password_full_pipeline.mdix -o ./output --password "FullPipeline@789"
// Decrypt: mdix decrypt ./output/security_05_password_full_pipeline.mdix.enc --password "FullPipeline@789"
// Note:    Also produces security_05_password_full_pipeline.mdix.au (audit trail)

@CONFIG(
  version -> "1.0.0"
  author  -> "MidManStudio Security Test — Full Pipeline"
)

@ENUMS(
  CloudProvider { AWS = 0, GCP = 1, AZURE = 2, DIGITALOCEAN = 3 }
  DBEngine      { POSTGRES = 0, MYSQL = 1, MONGO = 2, REDIS = 3 }
  Severity      { LOW = 0, MEDIUM = 1, HIGH = 2, CRITICAL = 3 }
)

@DLM(
  DCompressor.gzip
  DEncryptor.aes256
  DAuditor.enhanced
)

@QUICKFUNCS(
  ~k8sSecret<object>(name, namespace, data_keys) {
    return {
      name      = name
      namespace = namespace
      type      = "Opaque"
      data_keys = data_keys
      immutable = false
    }
  }

  ~dbEndpoint<object>(engine<enum>, host, port<int>, name, ssl<bool>) {
    return {
      engine   = engine
      host     = host
      port     = port
      name     = name
      ssl      = ssl
      pool_min = 2
      pool_max = 20
    }
  }

  ~alertRule<object>(name, severity<enum>, threshold<int>, channel) {
    return {
      name      = name
      severity  = severity
      threshold = threshold
      channel   = channel
      cooldown  = 300
    }
  }

  ~webhookConfig<object>(url, secret, events) {
    return {
      url     = url
      secret  = secret
      events  = events
      retries = 3
      timeout = 10
    }
  }
)

@DATA(
  cloud<enum>   = CloudProvider.AWS
  db_engine<enum> = DBEngine.POSTGRES
  app_name      = "InfraCore"
  version       = "5.0.0"
  datacenter    = "us-east-1a"

  primary_db:  dbEndpoint(DBEngine.POSTGRES, "pg.prod.internal",    5432, "core_prod",    true)
  analytics_db: dbEndpoint(DBEngine.POSTGRES, "pg-analytics.prod.internal", 5432, "analytics_prod", true)
  cache_db:    dbEndpoint(DBEngine.REDIS,    "redis.prod.internal",  6379, "0",            false)
  document_db: dbEndpoint(DBEngine.MONGO,    "mongo.prod.internal",  27017, "core_docs",   true)

  k8s_secrets::
    k8sSecret("db-credentials",   "production", ["DB_URL", "DB_PASSWORD"])
    k8sSecret("api-keys",         "production", ["STRIPE_KEY", "SENDGRID_KEY"])
    k8sSecret("tls-certificates", "production", ["TLS_CERT", "TLS_KEY"])
    k8sSecret("service-accounts", "production", ["SA_TOKEN", "SA_KEY"])

  alert_rules::
    alertRule("CPU above 90%",           Severity.HIGH,     90,  "#ops-alerts")
    alertRule("Memory above 85%",        Severity.HIGH,     85,  "#ops-alerts")
    alertRule("Error rate above 1%",     Severity.CRITICAL, 1,   "#oncall")
    alertRule("DB connections above 80", Severity.MEDIUM,   80,  "#db-team")
    alertRule("Disk above 75%",          Severity.MEDIUM,   75,  "#ops-alerts")

  stripe_webhook:   webhookConfig("https://api.prod/webhooks/stripe",   "whsec_replace_me", "payment_intent.succeeded,charge.failed")
  github_webhook:   webhookConfig("https://api.prod/webhooks/github",   "github_secret_replace_me", "push,pull_request")
  pagerduty_webhook: webhookConfig("https://api.prod/webhooks/pd",      "pd_secret_replace_me", "incident.trigger")

  // Core secrets (will be encrypted + compressed + audited)
  master_encryption_key  = "64_hex_char_master_key_replace_with_cryptographically_random_value_here"
  primary_db_password    = "primary_db_prod_password_replace_me"
  analytics_db_password  = "analytics_db_prod_password_replace_me"
  mongo_connection_str   = "mongodb://user:replace_password@mongo.prod.internal:27017/core_docs?ssl=true"
  redis_auth_password    = "redis_auth_password_replace_me"

  jwt_signing_key        = "jwt_hs512_key_replace_with_512bit_random_value"
  jwt_refresh_key        = "jwt_refresh_key_replace_with_512bit_random_value"

  stripe_secret_key      = "sk_live_replace_with_real_stripe_secret"
  stripe_webhook_secret  = "whsec_replace_with_real_stripe_webhook_secret"
  sendgrid_api_key       = "SG.replace_with_real_sendgrid_api_key"
  datadog_api_key        = "dd_api_replace_with_real_key"
  pagerduty_routing_key  = "pd_routing_key_replace_me"
  vault_token            = "hvs.replace_with_real_hashicorp_vault_token"
)

@SECURITY(
  encryption -> {
    mode      = "password"
    algorithm = "aes256-gcm"
  }
)
