  "how_to_use_dixcore": {
    "scenario_1_list": {
      "description": "Working with dynamic lists",
      "csharp_code": "var tokens = new List<Token>();\ntokens.Add(token1);\ntokens.Add(token2);\nvar keywords = tokens.Where(t => t.TokenType is Keyword).ToList();",
      "rust_code": "let mut tokens = List::New();\ntokens.Add(token1);\ntokens.Add(token2);\nlet keywords = tokens.Where(|t| matches!(t.TokenType, TokenType::Keyword(_)));"
    },
    "scenario_2_dictionary": {
      "description": "Symbol table / configuration",
      "csharp_code": "var symbolTable = new Dictionary<string, Symbol>();\nsymbolTable.Add(\"x\", symbol);\nif (symbolTable.TryGetValue(\"x\", out var sym)) { ... }",
      "rust_code": "let mut symbol_table = Dictionary::New();\nsymbol_table.Add(\"x\".to_string(), symbol);\nif let Some(sym) = symbol_table.TryGetValue(&\"x\".to_string()) { ... }"
    },
    "scenario_3_linq": {
      "description": "Complex data queries",
      "csharp_code": "var results = items\n  .Where(x => x.Value > 10)\n  .OrderBy(x => x.Name)\n  .Select(x => x.ToString())\n  .Take(5);",
      "rust_code": "let results = Linq::Take(\n  Linq::Select(\n    Linq::OrderBy(\n      Linq::Where(items, |x| x.Value > 10),\n      |x| &x.Name\n    ),\n    |x| x.ToString()\n  ),\n  5\n);"
    },
    "scenario_4_result": {
      "description": "Error handling with Result",
      "csharp_code": "var result = Dix.Load(\"config.mdix\");\nresult.Match(\n  success => Console.WriteLine(success),\n  error => Console.WriteLine(error)\n);",
      "rust_code": "let result = Dix::Load(\"config.mdix\");\nresult.Match(\n  |success| println!(\"{:?}\", success),\n  |error| println!(\"{}\", error)\n);"
    },
    "scenario_5_logger": {
      "description": "Structured logging with scopes",
      "csharp_code": "logger.Info(\"Starting\");\nusing (logger.CreateScope(\"Lexer\")) {\n  logger.Debug(\"Tokenizing\");\n}",
      "rust_code": "logger.Info(\"Starting\");\n{\n  let _scope = logger.CreateScope(\"Lexer\");\n  logger.Debug(\"Tokenizing\");\n}"
    }
  },

  "building_and_testing": {
    "setup": {
      "install_rust": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh",
      "verify": "rustc --version && cargo --version",
      "clone": "git clone https://github.com/Mid-D-Man/DixScript.git && cd DixScript-Rust"
    },
    "commands": {
