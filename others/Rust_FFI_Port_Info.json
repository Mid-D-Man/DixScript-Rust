  "ffi_strategy": {
    "overview": "Generate bindings automatically using UniFFI and csbindgen",
    "c_api_layer": {
      "purpose": "Stable C ABI for all language bindings",
      "location": "src/ffi.rs",
      "example": "extern \"C\" fn dix_parse(source: *const c_char, len: usize) -> *mut DixHandle"
    },
    "csharp_bindings": {
      "tool": "csbindgen",
      "install": "cargo install csbindgen",
      "generate": "csbindgen --crate dixscript --output bindings/csharp/DixScript.Native.cs",
      "usage_in_unity": "[DllImport(\"dixscript\")]\nprivate static extern IntPtr dix_parse([MarshalAs(UnmanagedType.LPUTF8Str)] string source);"
    },
    "javascript_bindings": {
      "tool": "wasm-bindgen",
      "install": "cargo install wasm-pack",
      "generate": "wasm-pack build --target web",
      "usage": "import { parse_dixscript } from './pkg/dixscript.js';\nconst result = parse_dixscript(source);"
    },
    "python_bindings": {
      "tool": "PyO3",
      "add_dep": "[dependencies]\npyo3 = { version = \"0.20\", features = [\"extension-module\"] }",
      "build": "maturin develop",
      "usage": "import dixscript\nresult = dixscript.parse(source)"
    },
    "multi_language_uniffi": {
      "tool": "UniFFI (Mozilla)",
      "add_dep": "[dependencies]\nuniffi = \"0.25\"",
      "define_interface": "Create dixscript.udl file",
      "generate_all": "cargo uniffi-bindgen generate src/dixscript.udl --language kotlin --language swift --language python",
      "benefit": "Single definition → Multiple languages automatically"
    }
  },

  "deployment": {
    "targets": {
      "windows": {
        "build": "cargo build --release --target x86_64-pc-windows-msvc",
        "output": "target/x86_64-pc-windows-msvc/release/dixscript.dll"
      },
      "macos": {
        "build": "cargo build --release --target x86_64-apple-darwin",
        "output": "target/x86_64-apple-darwin/release/libdixscript.dylib"
      },
      "linux": {
        "build": "cargo build --release --target x86_64-unknown-linux-gnu",
        "output": "target/x86_64-unknown-linux-gnu/release/libdixscript.so"
      },
      "ios": {
        "build": "cargo build --release --target aarch64-apple-ios",
        "output": "target/aarch64-apple-ios/release/libdixscript.a"
      },
      "android": {
        "build": "cargo ndk --target aarch64-linux-android --platform 21 -- build --release",
        "output": "target/aarch64-linux-android/release/libdixscript.so"
      },
      "wasm": {
        "build": "wasm-pack build --target web",
        "output": "pkg/dixscript_bg.wasm + pkg/dixscript.js"
      }
    },
    "unity_integration": {
      "steps": [
        "1. Build Rust library for target platform",
        "2. Generate C# bindings with csbindgen",
        "3. Copy libdixscript.dll/so/dylib to Unity/Assets/Plugins/",
        "4. Copy DixScript.Native.cs to Unity/Assets/Scripts/",
        "5. Use: var result = DixNative.Parse(source);"
      ]
    }
  },

