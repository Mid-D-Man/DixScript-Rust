  "🔥_CRITICAL_RUST_RULES": {
    "⚠️_READ_FIRST": "These rules prevent 95% of Rust compilation errors",

    "1_THE_GOLDEN_RULE": {
      "rule": "Aliasing XOR Mutability - NEVER both at the same time",
      "explanation": "You can have MANY immutable references OR ONE mutable reference, NEVER both",
      "visual": [
        "✅ ALLOWED:",
        "  let r1 = &data;  // immutable",
        "  let r2 = &data;  // immutable",
        "  let r3 = &data;  // unlimited immutable borrows",
        "",
        "✅ ALLOWED:",
        "  let r1 = &mut data;  // ONLY ONE mutable borrow",
        "",
        "❌ FORBIDDEN:",
        "  let r1 = &data;      // immutable",
        "  let r2 = &mut data;  // ERROR! Can't have both"
      ]
    },

    "2_OWNERSHIP_FLOW": {
      "rule": "Each value has EXACTLY ONE owner. When owner drops, value is freed.",
      "three_choices": {
        "MOVE": {
          "what": "Transfer ownership (original becomes invalid)",
          "cost": "FREE (just pointer reassignment)",
          "example": "let s2 = s1; // s1 MOVED, cannot use anymore",
          "when_to_use": "Passing to function that will consume/own the data"
        },
        "BORROW": {
          "what": "Temporary read-only access",
          "cost": "FREE (just a pointer)",
          "example": "fn read(data: &String) { ... }",
          "when_to_use": "Function needs to READ but not own"
        },
        "CLONE": {
          "what": "Deep copy - creates NEW independent value",
          "cost": "EXPENSIVE (allocates + copies all data)",
          "example": "let s2 = s1.clone(); // Both valid, but costly",
          "when_to_use": "⚠️ ONLY when you TRULY need TWO independent copies"
        }
      }
    },

    "3_LIFETIME_BASICS": {
      "rule": "References must NEVER outlive the data they point to",
      "when_needed": "When compiler can't infer (multiple inputs/outputs, struct fields)",
      "syntax": "'a is a lifetime parameter - means 'lives at least as long as a'",
      "examples": {
        "function": {
          "code": "fn longest<'a>(s1: &'a str, s2: &'a str) -> &'a str",
          "meaning": "Output lives as long as BOTH inputs (shortest lifetime)"
        },
        "struct": {
          "code": "struct Parser<'a> { source: &'a str }",
          "meaning": "Parser cannot outlive the source string it references"
        }
      },
      "when_NOT_needed": [
        "Single input, single output - compiler infers",
        "All owned data (String, Vec, etc.) - no lifetimes needed",
        "Static data ('static lifetime)"
      ]
    },

    "4_AVOID_CLONING": {
      "rule": "Clone is your LAST resort, not your first",
      "performance_impact": "10-1000x slower than borrowing",
      "decision_tree": [
        "1. Do I need to OWN this data? → Move or clone",
        "2. Do I just need to READ it? → Borrow (&T)",
        "3. Do I need to MODIFY temporarily? → Mutable borrow (&mut T)",
        "4. Is borrow checker complaining? → DON'T clone yet, understand WHY first"
      ],
      "valid_clone_reasons": [
        "Storing in multiple independent collections",
        "Sending to another thread (consider Arc<T> instead)",
        "Creating snapshot before modification",
        "Working around complex lifetimes (after trying borrowing)"
      ],
      "invalid_clone_reasons": [
        "❌ Cloning just to satisfy borrow checker",
        "❌ Cloning in hot loops (lexer, parser)",
        "❌ Cloning when function only reads",
        "❌ Cloning to iterate",
        "❌ Cloning in return values when & would work"
      ]
    },

    "5_VALUE_USED_AFTER_MOVE": {
      "error": "value used here after move",
      "cause": "Tried to use value after transferring ownership",
      "example_wrong": [
        "let s1 = String::from(\"hello\");",
        "let s2 = s1;  // s1 MOVED to s2",
        "println!(\"{}\", s1);  // ❌ ERROR: s1 is invalid"
      ],
      "fixes": {
        "fix_1_use_before_move": [
          "println!(\"{}\", s1);  // Use first",
          "let s2 = s1;  // Then move"
        ],
        "fix_2_clone": [
          "let s2 = s1.clone();  // Both valid (expensive)"
        ],
        "fix_3_borrow": [
          "let s2 = &s1;  // Just borrow instead"
        ]
      }
    },

    "6_CANNOT_BORROW_AS_MUTABLE": {
      "error": "cannot borrow as mutable because it is also borrowed as immutable",
      "cause": "Violating the golden rule (aliasing XOR mutability)",
      "example_wrong": [
        "let r1 = &data;      // immutable borrow",
        "let r2 = &mut data;  // ❌ ERROR: can't have both"
      ],
      "fix": [
        "{",
        "  let r1 = &data;",
        "  println!(\"{}\", r1);",
        "}  // r1 dropped here",
        "let r2 = &mut data;  // ✅ OK now"
      ],
      "pattern": "Ensure immutable borrow ENDS before mutable borrow starts"
    },

    "7_FILE_OWNERSHIP_PATTERNS": {
      "rule": "Decide WHO OWNS the data in each file/struct",
      "patterns": {
        "OWNED_DATA": {
          "when": "File/struct creates and fully owns its data",
          "types": "String, Vec<T>, HashMap<K,V>",
          "example": "struct Lexer { tokens: Vec<Token> }",
          "no_lifetimes": "No lifetime annotations needed"
        },
        "BORROWED_DATA": {
          "when": "File/struct references data owned elsewhere",
          "types": "&str, &[T], &HashMap<K,V>",
          "example": "struct Parser<'a> { source: &'a str }",
          "needs_lifetimes": "⚠️ MUST annotate lifetimes"
        },
        "MIXED": {
          "when": "Some owned, some borrowed",
          "example": "struct Compiler<'a> { config: Config, source: &'a str }",
          "needs_lifetimes": "Only for borrowed fields"
        }
      }
    }
  },

  "📋_ERROR_MANAGER_COMPLETE_API": {
    "overview": {
      "pattern": "Thread-safe singleton using Arc<Mutex<T>>",
      "access": "let error_mgr = ErrorManager::get_shared_instance();",
      "thread_safety": "All methods are thread-safe via internal Mutex"
    },

    "error_types_and_when_to_use": {
      "LexicalError": {
        "when": "Tokenization/lexer phase errors",
        "types": [
          "InvalidCharacter - unknown character in source",
          "UnterminatedString - missing closing quote",
          "InvalidNumber - malformed number literal",
          "InvalidEscapeSequence - bad \\x in string",
          "UnexpectedEndOfInput - EOF during token",
          "InvalidToken - token doesn't match any pattern"
        ],
        "severity": "Error (or Fatal if error_handling=halt)"
      },
      "ParseError": {
        "when": "Parsing/syntax errors",
        "types": [
          "UnexpectedToken - wrong token type",
          "MissingToken - expected token not found",
          "InvalidSyntax - malformed syntax",
          "UnknownStaticObject - unknown built-in like Math2",
          "UnknownStaticMethod - unknown method like Array.map2",
          "UnknownInstanceMethod - unknown method on value",
          "InvalidMethodSignature - wrong number/type of args",
          "InvalidBuiltinCall - incorrect builtin usage"
        ],
        "severity": "Error (or Fatal if error_handling=halt)"
      },
      "SemanticError": {
        "when": "Semantic analysis phase",
        "types": [
          "TypeMismatch - type incompatibility",
          "UndefinedVariable - variable not declared",
          "DuplicateDeclaration - redeclaration",
          "InvalidOperation - operation not supported",
          "CircularDependency - circular reference detected"
        ],
        "severity": "Warning (usually non-fatal)"
      },
      "ImportsResolutionError": {
        "when": "Import resolution failures",
        "types": [
          "FileNotFound - import file doesn't exist",
          "CircularImport - circular import chain",
          "InvalidPath - malformed import path",
          "HashMismatch - verify hash doesn't match",
          "CloudFetchFailed - cloud download failed"
        ],
        "severity": "Error (or Fatal if error_handling=halt)"
      },
      "AstEnhancementError": {
        "when": "AST enhancement/transformation phase",
        "types": [
          "QualifiedIdentifierResolution - failed to resolve qualified name",
          "FunctionSignatureMismatch - signature doesn't match",
          "InvalidTypeAnnotation - bad type annotation"
        ],
        "severity": "Error"
      },
      "ValueResolutionError": {
        "when": "QuickFunc evaluation/value resolution",
        "types": [
          "UndefinedVariable - variable not found in scope",
          "FunctionCallFailed - function execution error",
          "InvalidArgument - wrong argument type/value",
          "DivisionByZero - division by zero in expression"
        ],
        "severity": "Error"
      },
      "DlmError": {
        "when": "DLM pipeline (compression/encryption/audit) errors",
        "types": [
          "CompressionFailed - compression error",
          "EncryptionFailed - encryption error",
          "DecryptionFailed - decryption error",
          "AuditFailed - audit check failed",
          "ModuleLoadFailed - DLM module load error"
        ],
        "severity": "Error"
      },
      "BinarySerializationError": {
        "when": "Binary .mdix file serialization/deserialization",
        "types": [
          "InvalidFormat - not a valid .mdix file",
          "VersionMismatch - incompatible file version",
          "CorruptedData - checksum/integrity failure",
          "SerializationFailed - encoding error",
          "DeserializationFailed - decoding error"
        ],
        "severity": "Error"
      },
      "ConfigError": {
        "when": "@CONFIG section validation errors",
        "types": [
          "MissingRequiredField - required config missing",
          "InvalidValue - config value invalid",
          "InvalidFormat - config format wrong",
          "UnknownField - unknown config key"
        ],
        "severity": "Error"
      },
      "RuntimeError": {
        "when": "Runtime execution errors (DixData usage)",
        "types": [
          "KeyNotFound - key doesn't exist in DixData",
          "TypeConversionFailed - type cast error",
          "InvalidOperation - invalid runtime operation",
          "NullReference - null pointer/reference"
        ],
        "severity": "Error"
      },
      "GeneralError": {
        "when": "General/uncategorized errors",
        "types": [
          "InternalError - internal compiler bug",
          "IoError - file I/O failure",
          "UnexpectedError - unexpected condition"
        ],
        "severity": "Error"
      }
    },

    "add_error_methods": {
      "add_lexical_error": {
        "signature": "pub fn add_lexical_error(&self, error_type: LexicalErrorType, message: String, line: usize, column: usize, suggestion: Option<String>, source_line: Option<String>)",
