  "📝_LOGGING_BEST_PRACTICES": {
    "rule": "Check log level BEFORE formatting expensive strings",
    "rationale": "String formatting is expensive - avoid if message won't be logged",

    "wrong_pattern": [
      "❌ WRONG - Always formats string even if debug disabled:",
      "logger.Debug(&format!(\"Token: {:?}, Value: {}\", token, expensive_computation()));"
    ],

    "correct_patterns": {
      "pattern_1_variable_check": {
        "description": "Make a variable for the enabled check",
        "example": [
          "✅ CORRECT - Check first, then format:",
          "let is_debug_enabled = logger.IsDebugEnabled();",
          "if is_debug_enabled {",
          "  let msg = format!(\"Token: {:?}, Value: {}\", token, expensive_computation());",
          "  logger.DebugStr(&msg);",
          "}"
        ]
      },
      "pattern_2_closure": {
        "description": "Use closure for deferred evaluation (MID_Logger supports this)",
        "example": [
          "✅ CORRECT - Closure only evaluated if debug enabled:",
          "logger.Debug(|| {",
          "  format!(\"Token: {:?}, Value: {}\", token, expensive_computation())",
          "});"
        ]
      },
      "pattern_3_scope_guard": {
        "description": "Use RAII scope guards for structured logging",
        "example": [
          "✅ CORRECT - Automatic scope tracking:",
          "{",
          "  let _scope = logger.CreateDebugScope(\"ParseExpression\");",
          "  // ... parsing logic ...",
          "}  // Scope automatically ends here (RAII)"
        ]
      }
    },

    "logger_methods": {
      "Error": {
        "signature": "pub fn Error(&mut self, message: &str)",
        "always_logs": "Yes - errors always logged regardless of level"
      },
      "Warning": {
        "signature": "pub fn Warning(&mut self, message: &str)",
        "always_logs": "Yes - warnings always logged"
      },
      "Info": {
        "signature": "pub fn Info(&mut self, message: &str)",
        "check_level": "Logs if level <= Info"
      },
      "Debug": {
        "signature": "pub fn Debug<F>(&mut self, message_builder: F) where F: FnOnce() -> String",
        "check_level": "Logs if level <= Debug",
        "pattern": "Use closure: logger.Debug(|| format!(\"...\"));"
      },
      "DebugStr": {
        "signature": "pub fn DebugStr(&mut self, message: &str)",
        "check_level": "Logs if level <= Debug",
        "pattern": "Direct string: logger.DebugStr(&msg);"
      },
      "Verbose": {
        "signature": "pub fn Verbose<F>(&mut self, message_builder: F) where F: FnOnce() -> String",
        "check_level": "Logs if level <= Debug (verbose is subset of debug)"
      }
    },

    "check_methods": {
      "IsDebugEnabled": {
        "signature": "pub fn IsDebugEnabled(&self) -> bool",
        "usage": "if logger.IsDebugEnabled() { ... }"
      },
      "IsVerboseEnabled": {
        "signature": "pub fn IsVerboseEnabled(&self) -> bool",
        "usage": "if logger.IsVerboseEnabled() { ... }"
      },
      "WouldLog": {
        "signature": "pub fn WouldLog(&self, level: LogLevel) -> bool",
        "usage": "if logger.WouldLog(LogLevel::Info) { ... }"
      }
    },

    "scope_guards": {
      "CreateScope": {
        "signature": "pub fn CreateScope<'a>(&'a mut self, scope_name: &str) -> LoggerScope<'a>",
        "level": "Info",
        "example": [
          "let _scope = logger.CreateScope(\"CompileFile\");",
          "// Logs '▶ CompileFile' on enter",
          "// ... work ...",
          "// Logs '◀ CompileFile' on drop (automatic)"
        ]
      },
      "CreateDebugScope": {
        "signature": "pub fn CreateDebugScope<'a>(&'a mut self, scope_name: &str) -> LoggerScope<'a>",
        "level": "Debug"
      },
      "CreateVerboseScope": {
        "signature": "pub fn CreateVerboseScope<'a>(&'a mut self, scope_name: &str) -> LoggerScope<'a>",
        "level": "Debug (verbose)"
      },
      "note": "LoggerScope uses RAII - automatically calls end_scope on drop"
    }
  },

  "⚙️_OPERATIONAL_SETTINGS": {
    "what": "Runtime configuration extracted from @CONFIG section",
    "location": "src/Compiler/Core/Config/operational_settings.rs",

    "struct_definition": {
      "fields": {
        "version": {
          "type": "String",
          "default": "\"1.0.0\".to_string()",
          "description": "DixScript version"
        },
        "error_handling_strategy": {
          "type": "ErrorHandlingStrategy",
          "default": "ErrorHandlingStrategy::Halt",
          "values": ["Halt", "Continue", "Recover"],
          "description": "How to handle compilation errors"
        },
        "compatibility_mode": {
          "type": "CompatibilityMode",
          "default": "CompatibilityMode::Strict",
          "values": ["Strict", "BestEffort", "Permissive"],
          "description": "Compatibility enforcement level"
        },
        "debug_mode": {
          "type": "DebugMode",
          "default": "DebugMode::Off",
          "values": ["Off", "Regular", "Verbose"],
          "description": "Debug logging level"
        },
        "enabled_features": {
          "type": "Vec<String>",
          "default": "vec![\"advanced\".to_string()]",
          "description": "Enabled DixScript features"
        }
      }
    },

    "usage_patterns": {
      "create_default": {
        "code": "let settings = OperationalSettings::default();"
      },
      "from_config": {
        "code": [
          "let config = parse_config_section()?;",
          "let settings = ConfigSchema::extract_operational_settings(&config);"
        ]
      },
      "update_error_manager": {
        "code": [
          "let error_mgr = ErrorManager::get_shared_instance();",
          "error_mgr.update_settings(settings);"
        ]
      },
      "check_strategy": {
        "code": [
          "match settings.error_handling_strategy {",
          "  ErrorHandlingStrategy::Halt => {",
          "    // Stop on first error",
          "    if error_mgr.has_errors() { return Err(...); }",
          "  }",
          "  ErrorHandlingStrategy::Continue => {",
          "    // Collect all errors, continue parsing",
          "  }",
          "  ErrorHandlingStrategy::Recover => {",
          "    // Attempt error recovery",
          "  }",
          "}"
        ]
      }
    },

    "error_handling_strategies": {
      "Halt": {
        "behavior": "Stop immediately on first error",
        "severity_change": "Lexer/Parser errors become Fatal",
        "use_when": "Strict compilation, CI/CD pipelines"
      },
      "Continue": {
        "behavior": "Collect all errors, continue compilation",
        "severity_change": "Errors remain Error severity",
        "use_when": "IDE integration, interactive development"
      },
      "Recover": {
        "behavior": "Attempt error recovery and continue",
        "severity_change": "Some errors may be downgraded",
        "use_when": "Best-effort compilation, error-tolerant tools"
      }
    },

    "debug_modes": {
      "Off": {
        "logger_level": "LogLevel::Info",
        "output": "Only Info, Warning, Error messages"
      },
      "Regular": {
        "logger_level": "LogLevel::Debug",
        "output": "Includes Debug messages"
      },
      "Verbose": {
        "logger_level": "LogLevel::Debug",
        "output": "Includes Debug + Verbose messages"
      }
    }
  },

  "🚨_RUST_EXCEPTION_HANDLING": {
    "rule": "Rust doesn't have exceptions - use Result<T, E> for error propagation",

    "result_type": {
      "definition": "enum Result<T, E> { Ok(T), Err(E) }",
      "standard": "Use std::result::Result<T, E>",
      "project_alias": "pub type DixResult<T> = Result<T, DixError>;",
      "never_use": "❌ DON'T create custom Result wrapper - use Rust's built-in"
    },

    "error_propagation": {
      "question_mark_operator": {
        "syntax": "let value = might_fail()?;",
        "meaning": "If Err, RETURN immediately with that Err. If Ok, unwrap value.",
        "example": [
          "fn compile_file(path: &str) -> DixResult<Ast> {",
          "  let source = read_file(path)?;  // Auto-return Err if read fails",
          "  let tokens = tokenize(&source)?;  // Auto-return Err if tokenize fails",
          "  let ast = parse(tokens)?;  // Auto-return Err if parse fails",
          "  Ok(ast)  // Success",
          "}"
        ]
      },
      "match_pattern": {
        "when": "Need custom handling for each case",
        "example": [
          "match tokenize(&source) {",
          "  Ok(tokens) => process(tokens),",
          "  Err(e) => {",
          "    eprintln!(\"Tokenization failed: {}\", e);",
          "    return Err(e);",
          "  }",
          "}"
        ]
      },
      "if_let_pattern": {
        "when": "Only care about one variant",
        "example": [
          "if let Err(e) = validate_config(&config) {",
          "  error_mgr.add_config_error(...);",
          "  return Err(e);",
          "}"
        ]
      }
    },

    "error_types": {
      "dixscript_errors": {
        "pattern": "Use specific error types with ErrorManager",
        "example": [
          "// When error occurs:",
          "error_mgr.add_parse_error(",
          "  ParseErrorType::UnexpectedToken,",
          "  message,",
          "  line,",
          "  column,",
          "  suggestion,",
          "  source_line",
          ");",
          "",
          "// Then return Error:",
          "return Err(DixError::ParseError(\"Parsing failed\".to_string()));"
        ]
      },
      "never_panic": {
        "rule": "❌ NEVER use panic!(), unwrap(), or expect() in library code",
        "reason": "Library should return errors, not crash the program",
        "exceptions": [
          "✅ Test code (panic is OK in #[cfg(test)])",
          "✅ When impossible state is reached (should_never_happen)",
          "✅ In examples/binaries (not library code)"
        ],
        "use_instead": [
          "Use '?' operator for propagation",
          "Use .ok_or() to convert Option to Result",
          "Use match to handle all cases"
        ]
      }
    },

    "converting_option_to_result": {
      "problem": "Function returns Option<T> but you need Result<T, E>",
      "solutions": {
        "ok_or": {
          "usage": "let value = maybe_value.ok_or(error)?;",
          "example": [
            "let token = tokens.get(index)",
            "  .ok_or(DixError::ParseError(\"Unexpected EOF\".to_string()))?;"
          ]
        },
        "ok_or_else": {
          "usage": "let value = maybe_value.ok_or_else(|| create_error())?;",
          "example": [
            "let token = tokens.get(index)",
            "  .ok_or_else(|| {",
            "    DixError::ParseError(format!(\"Missing token at {}\", index))",
            "  })?;"
          ]
        }
      }
    },

    "common_patterns": {
      "early_return": {
        "description": "Check for errors early, return immediately",
        "example": [
          "if tokens.is_empty() {",
          "  error_mgr.add_parse_error(...);",
          "  return Err(DixError::ParseError(\"Empty token stream\".to_string()));",
          "}",
          "",
          "if error_mgr.should_terminate_parsing() {",
          "  return Err(DixError::ParseError(\"Too many errors\".to_string()));",
          "}"
        ]
      },
      "collect_errors_then_fail": {
        "description": "Collect multiple errors, then return if any",
        "example": [
          "for item in items {",
          "  if let Err(e) = validate_item(item) {",
          "    error_mgr.add_semantic_error(...);",
          "    // Continue to find ALL errors",
          "  }",
          "}",
          "",
          "if error_mgr.has_errors() {",
          "  return Err(DixError::SemanticError(\"Validation failed\".to_string()));",
          "}"
        ]
      }
    }
  },

  "🎯_HOT_PATH_OPTIMIZATION": {
    "definition": "Code executed 1000+ times per file (lexer loops, parser token consumption)",

    "critical_rules": [
      "❌ NEVER clone in hot paths",
      "❌ NEVER allocate (Vec::new()) in hot paths",
      "✅ Pre-allocate with capacity",
      "✅ Borrow, don't own",
      "✅ Use slices (&[T])",
      "✅ Keep iterators lazy (don't .collect() early)"
    ],

    "examples": {
      "lexer_main_loop": {
        "hot_path": "Yes - runs once per character",
        "wrong": [
          "❌ for ch in source.chars() {",
          "  let token = Token { value: ch.to_string().clone(), ... };",
          "  tokens.push(token.clone());",
          "}"
        ],
        "right": [
          "✅ let mut tokens = Vec::with_capacity(estimate_token_count(source.len()));",
          "for ch in source.chars() {",
          "  tokens.push(Token { value: ch, ... });  // No clone",
          "}"
        ]
      },
      "parser_token_consumption": {
        "hot_path": "Yes - runs once per token",
        "wrong": [
          "❌ fn current_token(&self) -> Token {",
          "  self.tokens[self.index].clone()  // Clone on EVERY call",
          "}"
        ],
        "right": [
          "✅ fn current_token(&self) -> &Token {",
          "  &self.tokens[self.index]  // Just borrow",
          "}"
        ]
      },
      "error_reporting": {
        "hot_path": "No - only called on errors (rare)",
        "ok_to_clone": "Yes - readability > micro-optimization",
        "example": [
          "✅ error_mgr.add_parse_error(",
          "  ...,",
          "  Some(source_line.clone())  // OK - error path is cold",
          ");"
        ]
      }
    },

    "pre_allocation": {
      "rule": "Always pre-allocate collections in hot paths",
      "helper_functions": [
        "estimate_properties_count(token_count) -> usize",
        "estimate_array_items_count(token_count) -> usize",
        "estimate_statements_count(token_count) -> usize",
        "estimate_enum_fields_count(token_count) -> usize"
      ],
      "usage": [
        "// Reduces allocations by 15-20%",
        "let capacity = estimate_properties_count(tokens.len());",
        "let mut properties = Vec::with_capacity(capacity);"
      ]
    }
  },

  "📚_COMMON_ANTI_PATTERNS": {
    "1_unnecessary_cloning": {
      "pattern": "Cloning when borrowing would work",
      "wrong": [
        "fn process_token(token: Token) {",
        "  println!(\"{}\", token.value);",
        "}"
      ],
      "right": [
        "fn process_token(token: &Token) {",
        "  println!(\"{}\", token.value);",
        "}"
      ]
    },
    "2_returning_owned_string": {
      "pattern": "Returning String when &str would work",
      "wrong": [
        "fn get_keyword() -> String {",
        "  \"if\".to_string()  // Unnecessary allocation",
        "}"
      ],
      "right": [
        "fn get_keyword() -> &'static str {",
        "  \"if\"  // No allocation",
        "}"
      ]
    },
    "3_collect_then_iterate": {
      "pattern": "Collecting iterator just to iterate again",
      "wrong": [
        "tokens.iter()",
        "  .filter(|t| t.is_keyword())",
        "  .collect::<Vec<_>>()",
        "  .iter()  // Wasteful - already had iterator",
        "  .map(|t| t.value)"
      ],
      "right": [
        "tokens.iter()",
        "  .filter(|t| t.is_keyword())",
        "  .map(|t| t.value)  // Keep it lazy"
      ]
    },
    "4_string_concat_in_loop": {
      "pattern": "String concatenation in loop (O(n²))",
      "wrong": [
        "let mut result = String::new();",
        "for s in &strings {",
        "  result = result + s;  // O(n²) - reallocates each time",
        "}"
      ],
      "right": [
        "let result = strings.join(\"\");  // O(n) - single allocation"
      ]
    },
    "5_unwrap_in_library_code": {
      "pattern": "Using unwrap() instead of proper error handling",
      "wrong": [
        "let token = tokens.get(index).unwrap();  // Panics on None"
      ],
      "right": [
        "let token = tokens.get(index)",
        "  .ok_or(DixError::ParseError(\"Unexpected EOF\".to_string()))?;"
      ]
    }
  },

  "🔄_ITERTOOLS_REPLACEMENTS": {
    "note": "Use itertools crate for LINQ-like operations",
    "dependency": "itertools = \"0.13\"",
    "import": "use itertools::Itertools;",

    "common_operations": {
      "sorted": {
        "c_sharp": "list.OrderBy(x => x.name)",
        "rust": "vec.iter().sorted_by_key(|x| &x.name).collect()"
      },
      "unique": {
        "c_sharp": "list.Distinct()",
        "rust": "vec.iter().unique().collect()"
      },
      "group_by": {
        "c_sharp": "list.GroupBy(x => x.category)",
        "rust": "vec.iter().group_by(|x| &x.category)"
      },
      "cartesian_product": {
        "c_sharp": "from a in list1 from b in list2 select (a, b)",
        "rust": "vec1.iter().cartesian_product(vec2.iter())"
      },
      "join": {
        "c_sharp": "list.Join(\", \")",
        "rust": "vec.iter().join(\", \")"
      }
    }
  },

  "📖_QUICK_REFERENCE": {
    "compilation_flow": [
      "1. Get ErrorManager: let error_mgr = ErrorManager::get_shared_instance();",
      "2. Create/Update settings: error_mgr.update_settings(settings);",
      "3. Tokenize: tokens = lexer.tokenize(&source)?;",
      "4. Check errors: if error_mgr.should_terminate_parsing() { return Err(...); }",
      "5. Parse: ast = parser.parse(tokens)?;",
      "6. Check errors: if error_mgr.has_errors() { return Err(...); }",
      "7. Analyze: analyzer.analyze(&ast)?;",
      "8. Report: if error_mgr.has_errors() { print error_mgr.generate_error_report(); }"
    ],

    "error_handling_checklist": [
      "✅ Add error to ErrorManager",
      "✅ Return Err with appropriate DixError variant",
      "✅ Use '?' for propagation",
      "✅ Never unwrap() in library code",
      "✅ Check should_terminate_parsing() in loops"
    ],

    "logging_checklist": [
      "✅ Check log level BEFORE formatting",
      "✅ Use closures for expensive formatting",
      "✅ Use scope guards for structured logging",
      "✅ Use appropriate log level (Debug/Info/Warning/Error)"
    ],

    "optimization_checklist": [
      "✅ Identify hot paths (called 1000+ times)",
      "✅ Pre-allocate collections in hot paths",
      "✅ Borrow, don't clone, in hot paths",
      "✅ Use slices (&[T]) for reading",
      "✅ Keep iterators lazy",
      "✅ Profile with cargo flamegraph BEFORE micro-optimizing"
    ]
  }
