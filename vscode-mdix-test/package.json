{
  "name": "vscode-mdix-test",
  "displayName": "DixScript (.mdix) — LSP Test Harness",
  "description": "Dev-only extension that wires VS Code to the local mdix-lsp binary.",
  "version": "0.0.1",
  "private": true,
  "publisher": "midmanstudio",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mdix",
        "aliases": ["DixScript", "mdix"],
        "extensions": [".mdix"],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch":   "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.82.0",
    "@types/node":   "^20.0.0",
    "typescript":    "^5.3.0"
  }
}
